# =============================================================================
# NEXO Backend API — Variables de Entorno
# Copiar a .env y configurar valores reales
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (requerido)
# -----------------------------------------------------------------------------
# Opción A: URL completa
DATABASE_URL=postgresql://usuario:password@localhost:5432/nexo

# Opción B: Variables separadas (si no se usa DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=nexo
# PGUSER=usuario
# PGPASSWORD=password

# -----------------------------------------------------------------------------
# REDIS (requerido)
# -----------------------------------------------------------------------------
REDISHOST=localhost
REDISPORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# SEGURIDAD — Cifrado de payloads EDGE (requerido)
# -----------------------------------------------------------------------------
NEXO_AES_KEY=cambiar-por-clave-de-32-caracteres-min

# -----------------------------------------------------------------------------
# SEGURIDAD — JWT (requerido: RS256 O HS256)
# -----------------------------------------------------------------------------
# Opción A: RS256 (recomendado para producción)
# JWT_PRIVATE_KEY=base64-de-clave-privada-PEM
# JWT_PUBLIC_KEY=base64-de-clave-publica-PEM

# Opción B: HS256 (más simple, menos seguro)
JWT_SECRET=cambiar-por-secreto-de-al-menos-32-caracteres

# JWT opcional
JWT_ISSUER=nexo-api
JWT_AUDIENCE=nexo-webapp
JWT_KEY_ID=nexo-key-1
JWT_ACCESS_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# CORS (requerido)
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# -----------------------------------------------------------------------------
# TWILIO — WhatsApp (opcional, solo para outbound)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WEBHOOK_URL_BASE=https://api.tu-dominio.com

# Teléfono para notificaciones de contacto (landing page)
# NEXO_OWNER_WHATSAPP=+573001234567

# -----------------------------------------------------------------------------
# AUDITORÍA — Cadena de hashes (opcional)
# -----------------------------------------------------------------------------
# APP_NEXO_HMAC_SECRET=cambiar-por-secreto-hmac

# -----------------------------------------------------------------------------
# FUNCIONALIDADES OPCIONALES
# -----------------------------------------------------------------------------
# APP_ENV=production
# LOGIN_2FA_ENABLED=false

# -----------------------------------------------------------------------------
# CHATBOT NLU — parser semántico LLM (requerido, compatible-OpenAI)
# -----------------------------------------------------------------------------
# El LLM es EL parser del chat: sin key todo cae a out_of_scope.
# Gratis con Groq (console.groq.com → API Keys, sin tarjeta):
# NLU_LLM_URL=https://api.groq.com/openai/v1
# NLU_LLM_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NLU_LLM_MODEL=qwen/qwen3.8-27b              # Groq free: 1k req/día, 8k tok/min
# # NLU_LLM_MODEL=openai/gpt-oss-120b        # alternativa en la misma cuenta
# NLU_LLM_MODE=on                           # off|on
# NLU_LLM_TIMEOUT_MS=6000
# NLU_LLM_COMPOSE=data                    # off|data|all — LLM#2 reformula el reply verificado
