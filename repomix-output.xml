</file>

<file path="Includes/.pio/libdeps/esp32dev/ArduinoJson/src/ArduinoJson/Numbers/FloatTraits.hpp">
// ArduinoJson - https://arduinojson.org
// Copyright © 2014-2026, Benoit BLANCHON
