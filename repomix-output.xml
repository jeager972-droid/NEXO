// CAMBIO 6: GSAP entrada cinematográfica y Scroll sticky

export default function HeroSection() {
  const wrapperRef  = useRef()
  const innerRef    = useRef()
  const eyebrowRef  = useRef()
  const line1Ref    = useRef()
  const line2Ref    = useRef()
