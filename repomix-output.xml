        $metrics[] = '# HELP redis_queue_length Current length of Redis queues';
        $metrics[] = '# TYPE redis_queue_length gauge';
        $metrics[] = 'redis_queue_length{queue="audit_logs"} ' . (int)$auditQueueLen;
