              {/* Error de servidor */}
              {errors._server && (
                <p style={{ fontSize: '0.78rem', color: '#ff7070', textAlign: 'center', padding: '0.5rem', background: 'rgba(255,80,80,0.08)', borderRadius: '0.5rem', border: '1px solid rgba(255,80,80,0.2)' }}>
                  {errors._server}
