          <ellipse class="ring-base" cx="520" cy="220" rx="460" ry="150" transform="rotate(12 520 220)"></ellipse>
          <ellipse class="ring-base" cx="520" cy="220" rx="340" ry="110" transform="rotate(12 520 220)"></ellipse>

          <ellipse class="ring-shine r1" cx="520" cy="220" rx="460" ry="150" transform="rotate(12 520 220)"></ellipse>
          <ellipse class="ring-shine r2" cx="520" cy="220" rx="340" ry="110" transform="rotate(12 520 220)"></ellipse>
        </svg>
      </div>

      <div class="nexo-core">
        <h1 class="nexo-text">
          <span class="char-span" data-char="N">N</span>
          <span class="custom-e">
            <span class="e-line"></span>
            <span class="e-line"></span>
            <span class="e-line"></span>
          </span>
          <span class="char-span" data-char="X">X</span>
          <span class="char-span" data-char="O">O</span>
        </h1>
        <p class="tagline">Data Transmission Systems</p>
      </div>
    </div>
  </div>

  <div class="nexo-node-container">
    <div id="nodeButton" class="nexo-node-button online"></div>
    <div class="nexo-node-label">Node Active</div>
  </div>

  <script>
    const canvas = document.getElementById('space');
    const ctx    = canvas.getContext('2d');
    let W, H;

    function resize() {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    let stars = [];
    function initStars() {
      stars = Array.from({ length: 400 }, () => ({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        size: Math.random() * 1.5,
        opacity: Math.random(),
        speed: 0.05 + Math.random() * 0.1
      }));
    }
    initStars();

    window.addEventListener('resize', () => {
      initStars();
    });

    function draw() {
      ctx.fillStyle = '#020617';
      ctx.fillRect(0, 0, W, H);

      stars.forEach(star => {
        ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
        ctx.fill();

        star.y -= star.speed;
        if (star.y < 0) {
          star.y = H;
          star.x = Math.random() * W;
        }
      });

      requestAnimationFrame(draw);
    }
    draw();
  </script>
</body>
