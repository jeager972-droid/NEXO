// 1. ASISTENCIA
// ============================================================================

// Reporte general
if ($cleanPath === '/audit/attendance/general' && $method === 'GET') {
    try {
        $f = auditFilters('be', 'event_timestamp');
        $where = $f['conds'] ? ' AND ' . implode(' AND ', $f['conds']) : '';
        $params = array_merge([$schoolId], $f['params']);

        $stmt = $conn->prepare("
