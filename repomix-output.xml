<file path="backend/alojamiento/.htaccess">
# ============================================================
# NEXO Security .htaccess - Hardened for Government Compliance
# Compatible con Apache 2.4 (php:8.2-apache Docker / Railway)
# ============================================================

# Deshabilitar listado de directorios
Options -Indexes

# Deshabilitar firma del servidor
ServerSignature Off

# ============================================================
# CONTROL DE ACCESO: Solo permitir api.php, index.html, style.css
# Usar mod_rewrite (universalmente compatible) en vez de FilesMatch
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ROUTING: Front Controller Pattern
    # Redirige todo lo que no sea un archivo o directorio real a api.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ api.php [QSA,L]

    # Bloquear acceso a carpeta .git
    RewriteRule ^\.git - [F,L]

    # Bloquear acceso a .env
    RewriteRule ^\.env - [F,L]

    # Bloquear acceso a carpeta _dev
    RewriteRule ^_dev(/|$) - [F,L]

    # Bloquear Dockerfile, start.sh, .dockerignore
    RewriteRule ^(Dockerfile|start\.sh|\.dockerignore)$ - [F,L]

    # Bloquear archivos sensibles por extensión
    RewriteRule \.(md|log|json|sh|gitignore)$ - [F,L]

    # Bloquear cualquier PHP que NO sea api.php
    RewriteCond %{REQUEST_FILENAME} \.php$
    RewriteCond %{REQUEST_FILENAME} !api\.php$
    RewriteRule .* - [F,L]

    # Prevenir hotlinking de recursos estáticos
    RewriteCond %{HTTP_REFERER} !^$ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(.+\.)?nexo\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?railway\.app [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?azure\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?azurewebsites\.net [NC]
    RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F,L]
</IfModule>

# ============================================================
# HEADERS DE SEGURIDAD
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
    # No exponer versión de PHP
    Header always unset X-Powered-By
</IfModule>
</file>

