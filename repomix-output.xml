    try {
        $limit = min(200, max(1, (int)($_GET['limit'] ?? 200)));
        $offset = max(0, (int)($_GET['offset'] ?? 0));
        $stmt = $conn->prepare("
            SELECT
                s.student_id as id,
                s.first_name,
                s.last_name,
                s.document_number,
                s.active,
                COALESCE(ag.group_name, 'Sin grupo') as group_name
            FROM students s
