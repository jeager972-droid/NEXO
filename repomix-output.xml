  const [loading, setLoading] = useState(true);
  
  const isStaff = user?.role === 'PORTERO' || user?.role === 'AUXILIAR';

  useEffect(() => {
    const fetchNotifications = async () => {
      try {
        const data = await notificationsApi.getAll();
        setNotifications(data);
