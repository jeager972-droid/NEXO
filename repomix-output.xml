           Serial.print(file.name());
           Serial.print("\tSIZE: ");
           Serial.println(file.size());
       }
       file = root.openNextFile();
   }

   // remove existing file
   LittleFS.remove("/test1.db");
   LittleFS.remove("/test2.db");

   sqlite3_initialize();

