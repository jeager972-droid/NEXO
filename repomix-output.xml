-- MIGRATION TABLES
CREATE TABLE IF NOT EXISTS rate_limits (rl_key TEXT PRIMARY KEY, window_start TIMESTAMPTZ NOT NULL DEFAULT NOW(), hits INTEGER NOT NULL DEFAULT 0);
