    git

# SQLite
sudo apt-get install -y \
    libsqlite3-dev

# Crypto (OpenSSL)
sudo apt-get install -y \
    libssl-dev

# HTTP client (libcurl)
sudo apt-get install -y \
    libcurl4-openssl-dev

# GPIO for Raspberry Pi (libgpiod)
# Note: This is for ARM64 Pi. On x86_64 dev, it's safe to install but won't be used.
sudo apt-get install -y \
    libgpiod-dev

