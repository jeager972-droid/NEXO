                  {formData.targetRole && !loadingUsers && targetUsers.length === 0 && (
                    <div className="px-3 py-2 text-xs text-slate-400 bg-slate-50 dark:bg-slate-800" style={{ border: '1.5px solid #E2E8F0' }}>
