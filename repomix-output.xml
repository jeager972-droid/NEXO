                        className="w-full pl-8 pr-3 py-2 text-xs outline-none dark:bg-slate-900 dark:text-white"
                        style={{ border: '1.5px solid #E2E8F0', backgroundColor: '#F8FAFC', fontWeight: 600, color: '#0F172A' }}
                      />
