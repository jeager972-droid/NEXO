        }

        input:checked + .toggle-slider:before {
          transform: translateX(20px);
        }

        input:disabled + .toggle-slider {
          opacity: 0.5;
          cursor: not-allowed;
        }

        .cookie-manager-footer {
          padding: 1.5rem;
          border-top: 1px solid rgba(45, 110, 48, 0.1);
          display: flex;
          gap: 0.75rem;
          flex-wrap: wrap;
        }

        .cookie-manager-btn {
          flex: 1;
          padding: 0.875rem 1.25rem;
          border-radius: 0.75rem;
          font-size: 0.875rem;
          font-weight: 600;
          cursor: pointer;
          transition: all 0.2s;
          border: none;
          min-width: 140px;
