      - PGPORT=6432
      - PGDATABASE=nexo_db
      - PGUSER=nexo_user
      - PGPASSWORD=${DB_PASSWORD}
    depends_on:
      - db
      - redis
      - pgbouncer
    networks:
      - nexo-internal


  biometric-worker:
    build:
      context: .
      dockerfile: Dockerfile
    command: php /var/www/html/worker_biometric.php
    environment:
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - PGHOST=pgbouncer
      - PGPORT=6432
      - PGDATABASE=nexo_db
      - PGUSER=nexo_user
      - PGPASSWORD=${DB_PASSWORD}
    depends_on:
      - db
      - redis
      - pgbouncer
    networks:
      - nexo-internal


  redis:
    image: redis:7-alpine
    command: redis-server --requirepass ${REDIS_PASSWORD} --appendonly yes
    volumes:
      - nexo-redis-data:/data
    networks:
      - nexo-internal


  pgbouncer:
    build:
      context: ./pgbouncer
    environment:
      - DB_USER=nexo_user
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_HOST=db
      - DB_NAME=nexo_db
    ports:
      - "6432:6432"
    depends_on:
      - db
    networks:
      - nexo-internal


  mosquitto:
    image: eclipse-mosquitto:2.0-openssl
    ports:
      - "1883:1883"
      - "9001:9001"
    volumes:
      - ./mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - nexo-mosquitto-data:/mosquitto/data
    networks:
      - nexo-internal

networks:
  nexo-internal:
    driver: bridge

volumes:
  nexo-db-data:
  nexo-redis-data:
  nexo-mosquitto-data:
