          )}

          {/* Warning: group selected but no activity today */}
          {selectedGroup && !groupLoading && groupStats && !hasActivity && (
            <div className="flex items-center gap-3 p-5 bg-white dark:bg-slate-900" style={{ border: '1.5px solid #E2E8F0' }}>
