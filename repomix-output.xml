  const q = query.trim().toLowerCase();
  const results = SEARCH_CATALOG.filter(item => {
    if (!item.roles.includes(userRole)) return false;
    const text = item.title.toLowerCase();
    const path = item.path.replace('/', '').toLowerCase();
