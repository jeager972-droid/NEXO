                        style={{ color: g === selectedGroup ? '#003366' : '#334155', background: g === selectedGroup ? 'rgba(0,51,102,0.04)' : 'none', border: 'none', cursor: 'pointer', borderBottom: '1px solid #F8FAFC' }}
                      >
                        {g}
                      </button>
                    ))
                  )}
