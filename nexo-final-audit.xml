import * as THREE from 'three'
import gsap from 'gsap'

// ─── GPU Rain — LineSegments vertex/fragment shaders ───────────────────────────
// Each raindrop = 2 vertices (top/bottom of streak).  No CPU updates per-frame:
// position is computed entirely in the vertex shader from uTime + aOffset.
// Fragment emits HDR-overbright white-blue so UnrealBloomPass gives rain glow.
const RAIN_VS = /* glsl */`
  attribute float aOffset;   // per-drop random phase [0, 1]
  attribute float aEnd;      // 0 = top vertex, 1 = bottom vertex

  uniform float uTime;

  const float FALL_SPEED = 0.42;   // full-field traversals per second
  const float WIND_X     = 2.60;   // lateral wind drift (world units)
  const float TOP_Y      =  9.0;   // rain spawn height
  const float BOT_Y      = -2.5;   // rain die height
  const float STREAK     = 0.038;  // bottom-vertex cycle offset = streak length fraction

  void main() {
    float cycle = fract(uTime * FALL_SPEED + aOffset);
    float t     = fract(cycle + aEnd * STREAK);

    vec3 pos;
    pos.x = position.x + t * WIND_X;
    pos.y = mix(TOP_Y, BOT_Y, t);
    pos.z = position.z;

    gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
  }
`

const RAIN_FS = /* glsl */`
  uniform float uOpacity;
  void main() {
    // HDR overbright blue-white — values > 1 trigger UnrealBloomPass
    gl_FragColor = vec4(1.10, 1.20, 1.55, uOpacity);
  }
`

// ─── Helpers ──────────────────────────────────────────────────────────────────

function buildRainGeometry(count) {
  const pos    = new Float32Array(count * 6)   // 2 verts × 3 coords
  const offset = new Float32Array(count * 2)
  const end    = new Float32Array(count * 2)

  for (let i = 0; i < count; i++) {
    const x   = (Math.random() - 0.5) * 22
    const z   = (Math.random() - 0.5) * 22
    const off = Math.random()

    pos[i * 6 + 0] = x;  pos[i * 6 + 1] = 0;  pos[i * 6 + 2] = z  // top
    pos[i * 6 + 3] = x;  pos[i * 6 + 4] = 0;  pos[i * 6 + 5] = z  // bottom

    offset[i * 2]     = off;  offset[i * 2 + 1] = off
    end[i * 2]        = 0;    end[i * 2 + 1]    = 1
  }

  const geo = new THREE.BufferGeometry()
  geo.setAttribute('position', new THREE.BufferAttribute(pos,    3))
  geo.setAttribute('aOffset',  new THREE.BufferAttribute(offset, 1))
  geo.setAttribute('aEnd',     new THREE.BufferAttribute(end,    1))
  return geo
}

// Procedural water-on-lens drip texture (camera overlay)
function buildLensTexture() {
  const W = 256, H = 512
  const cv = document.createElement('canvas')
  cv.width = W; cv.height = H
  const ctx = cv.getContext('2d')
  ctx.clearRect(0, 0, W, H)

  // Vertical drip streaks
  for (let i = 0; i < 30; i++) {
    const x  = Math.random() * W
    const y0 = Math.random() * H * 0.55
    const l  = H * 0.04 + Math.random() * H * 0.22
    const a  = 0.10 + Math.random() * 0.28

    const g = ctx.createLinearGradient(x, y0, x, y0 + l)
    g.addColorStop(0.00, `rgba(210,228,255, 0)`)
    g.addColorStop(0.12, `rgba(210,228,255, ${a})`)
    g.addColorStop(0.88, `rgba(180,215,255, ${a * 0.5})`)
    g.addColorStop(1.00, `rgba(180,215,255, 0)`)

    ctx.strokeStyle = g
    ctx.lineWidth   = 0.9 + Math.random() * 1.5
    ctx.beginPath()
    const cx1 = x + (Math.random() - 0.5) * 6
    const cx2 = x + (Math.random() - 0.5) * 6
    ctx.moveTo(x, y0)
    ctx.bezierCurveTo(cx1, y0 + l * 0.33, cx2, y0 + l * 0.66, x + (Math.random() - 0.5) * 5, y0 + l)
    ctx.stroke()
  }

  // Circular splash droplets
  for (let i = 0; i < 18; i++) {
    const x = Math.random() * W
    const y = Math.random() * H
    const r = 1.5 + Math.random() * 4
    const g = ctx.createRadialGradient(x, y, 0, x, y, r)
    g.addColorStop(0, `rgba(200,230,255, 0.38)`)
    g.addColorStop(1, `rgba(150,205,255, 0)`)
    ctx.fillStyle = g
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill()
  }

  const tex = new THREE.CanvasTexture(cv)
  return tex
}

// Animated sea surface — MeshStandardMaterial + normalMap + UV scroll in tick()
function buildWaterMesh(waterNormals) {
  if (waterNormals) {
    waterNormals.wrapS = waterNormals.wrapT = THREE.RepeatWrapping
    waterNormals.repeat.set(7, 7)
  }
  const geo = new THREE.PlaneGeometry(90, 90)
  const mat = new THREE.MeshStandardMaterial({
    color:       new THREE.Color(0x001824),
    roughness:   0.03,
    metalness:   0.92,
    normalMap:   waterNormals ?? null,
    normalScale: new THREE.Vector2(4.5, 4.5),
    transparent: true,
    opacity:     0.93,
    envMapIntensity: 1.5,
  })
  const mesh = new THREE.Mesh(geo, mat)
  mesh.rotation.x = -Math.PI / 2
  mesh.position.y = -1.62
  return mesh
}

// ─── ResistenciaScene ─────────────────────────────────────────────────────────
export class ResistenciaScene {
  /**
   * @param {{
   *   scene:    THREE.Scene,
   *   camera:   THREE.PerspectiveCamera,
   *   renderer: THREE.WebGLRenderer,
   *   composer: EffectComposer & { bloom: UnrealBloomPass },
   *   assets:   Record<string, any>,
   *   matCtrl:  MaterialController,
   * }} params
   */
  constructor({ scene, camera, renderer, composer, assets, matCtrl }) {
    this._scene    = scene
    this._camera   = camera
    this._renderer = renderer
    this._composer = composer
    this._assets   = assets
    this._matCtrl  = matCtrl

    this._rain       = null   // THREE.LineSegments (GPU rain)
    this._water      = null   // THREE.Mesh (sea surface)
    this._lens       = null   // THREE.Mesh (lens splash, camera child)
    this._lightning  = []     // active PointLights
    this._lightTimer = null

    this._active        = false
    this._savedBg       = null
    this._savedEnv      = null
    this._savedExposure = 1.0
  }

  // ── Build ─────────────────────────────────────────────────────────────────────
  build() {
    this._setupRain()
    this._setupWater()
    this._setupLens()
    this._setVisible(false)
    console.info('[ResistenciaScene] ✓ Built — GPU rain: 10k streaks, water, lens, lightning')
  }

  // ── GPU Rain (LineSegments — all animation in vertex shader) ─────────────────
  _setupRain() {
    const geo = buildRainGeometry(10000)
    const mat = new THREE.ShaderMaterial({
      vertexShader:   RAIN_VS,
      fragmentShader: RAIN_FS,
      uniforms: {
        uTime:    { value: 0 },
        uOpacity: { value: 0 },
      },
      transparent: true,
      depthWrite:  false,
      blending:    THREE.AdditiveBlending,
    })
    this._rain = new THREE.LineSegments(geo, mat)
    this._scene.add(this._rain)
  }

  // ── Animated sea surface ─────────────────────────────────────────────────────
  _setupWater() {
    const waterNormals = this._assets.waterNormals
    if (!waterNormals) {
      console.error('[ResistenciaScene] waternormals.jpg not loaded')
      return
    }

    const geo = new THREE.PlaneGeometry(30, 30, 128, 128)
    const mat = new THREE.MeshStandardMaterial({
      color:       new THREE.Color(0x001824),
      roughness:   0.03,
      metalness:   0.92,
      normalMap:   waterNormals ?? null,
      normalScale: new THREE.Vector2(4.5, 4.5),
      transparent: true,
      opacity:     0.93,
      envMapIntensity: 1.5,
    })
    const mesh = new THREE.Mesh(geo, mat)
    mesh.rotation.x = -Math.PI / 2
    mesh.position.y = -1.62
    this._water = mesh
    this._scene.add(this._water)
  }

  // ── Lens splash plane (camera child — follows camera automatically) ───────────
  _setupLens() {
    const mesh = new THREE.Mesh(
      new THREE.PlaneGeometry(1.5, 0.95),
      new THREE.MeshBasicMaterial({
        map:        buildLensTexture(),
        transparent: true,
        opacity:    0,
        depthTest:  false,
        depthWrite: false,
      }),
    )
    mesh.position.set(0, 0, -0.65)   // world: 0.65 units in front of camera
    mesh.renderOrder = 999
    this._camera.add(mesh)
    this._scene.add(this._camera)     // camera must be in scene for children to render
    this._lens = mesh
  }

  // ── Environment crossfade ─────────────────────────────────────────────────────
  _swapEnv(newEnv, targetIntensity) {
    const canTween = 'environmentIntensity' in this._scene
    const doSwap = () => {
      this._scene.environment = newEnv
      if (canTween) {
        gsap.to(this._scene, { environmentIntensity: targetIntensity, duration: 0.9,
          ease: 'power2.out' })
      }
    }
    if (canTween) {
      gsap.to(this._scene, { environmentIntensity: 0, duration: 0.50,
        ease: 'power2.in', onComplete: doSwap })
    } else { doSwap() }
  }

  // ── Lightning: double-flash PointLight, random interval ──────────────────────
  _triggerLightning() {
    const pl = new THREE.PointLight(0xc0d8ff, 60, 40)
    pl.position.set(
      (Math.random() - 0.5) * 14,
      5 + Math.random() * 5,
      (Math.random() - 0.5) * 8,
    )
    this._scene.add(pl)
    this._lightning.push(pl)

    gsap.timeline()
      .to(pl, { intensity: 90,  duration: 0.040 })
      .to(pl, { intensity: 6,   duration: 0.055 })
      .to(pl, { intensity: 75,  duration: 0.030 })
      .to(pl, { intensity: 0,   duration: 0.200, ease: 'power3.out',
        onComplete: () => {
          this._scene.remove(pl)
          this._lightning = this._lightning.filter(l => l !== pl)
        },
      })
  }

  _scheduleNextLightning() {
    if (!this._active) return
    const ms = (1.0 + Math.random() * 3.8) * 1000
    this._lightTimer = setTimeout(() => {
      this._triggerLightning()
      this._scheduleNextLightning()
    }, ms)
  }

  // ── Batch visibility ─────────────────────────────────────────────────────────
  _setVisible(v) {
    if (this._rain)  this._rain.visible  = v
    if (this._water) this._water.visible = v
    if (this._lens)  this._lens.visible  = v
  }

  // ── Section lifecycle ─────────────────────────────────────────────────────────
  enter() {
    if (this._active) return
    this._active = true

    // Save state for leave()
    this._savedBg       = this._scene.background
    this._savedEnv      = this._scene.environment
    this._savedExposure = this._renderer.toneMappingExposure

    // Swap to storm environment + dark exposure
    const stormEnv = this._assets.tormentaEnv ?? this._savedEnv
    this._swapEnv(stormEnv, 0.55)
    gsap.to(this._renderer, { toneMappingExposure: 0.38, duration: 1.4, ease: 'power2.inOut' })

    // Crank up bloom for rain glow
    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 1.30, duration: 1.2, ease: 'power2.out' })
    }

    this._setVisible(true)

    // Fade in rain
    gsap.to(this._rain.material.uniforms.uOpacity, { value: 0.60, duration: 1.5, ease: 'power2.out' })

    // Fade in lens splash
    gsap.to(this._lens.material, { opacity: 0.38, duration: 2.0, ease: 'power2.out' })

    // Wet node: roughness → 0.05, plastic metalness → 0.12 (via MaterialController)
    this._matCtrl.setWet()

    // Start lightning after a brief delay
    setTimeout(() => this._scheduleNextLightning(), 900)
  }

  leave() {
    if (!this._active) return
    this._active = false

    // Restore env + exposure
    this._swapEnv(this._savedEnv, 1.2)
    this._scene.background = this._savedBg
    gsap.to(this._renderer, { toneMappingExposure: this._savedExposure, duration: 1.0,
      ease: 'power2.inOut' })

    // Restore bloom baseline
    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 0.50, duration: 0.8, ease: 'power2.in' })
    }

    // Kill all pending lightning
    clearTimeout(this._lightTimer)
    this._lightning.forEach(l => { gsap.killTweensOf(l); this._scene.remove(l) })
    this._lightning = []

    // Fade out rain + lens
    gsap.to(this._rain.material.uniforms.uOpacity, { value: 0, duration: 0.8, ease: 'power2.in',
      onComplete: () => this._setVisible(false) })
    gsap.to(this._lens.material, { opacity: 0, duration: 0.6, ease: 'power2.in' })

    // Dry node
    this._matCtrl.setDry()
  }

  // ── Tick — advance rain shader clock + animate water normals ─────────────────
  tick(t) {
    if (!this._active) return

    this._rain.material.uniforms.uTime.value = t

    // Dual-direction UV scroll on water normal map for choppy surface
    if (this._water?.material?.normalMap) {
      this._water.material.normalMap.offset.x = t * 0.042
      this._water.material.normalMap.offset.y = t * 0.028
    }
  }

  // ── Cleanup ───────────────────────────────────────────────────────────────────
  dispose() {
    clearTimeout(this._lightTimer)
    this._rain?.geometry.dispose();  this._rain?.material.dispose()
    this._water?.geometry.dispose(); this._water?.material.normalMap?.dispose()
    this._water?.material.dispose()
    this._lens?.geometry.dispose();  this._lens?.material.map?.dispose()
    this._lens?.material.dispose();  this._camera.remove(this._lens)
  }
}
