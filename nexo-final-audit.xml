/* ─── Root & Canvas ──────────────────────────────────────────────────────────── */
.nx-root {
  position: relative;
  width: 100%;
  background: #000000 !important;
}

.nx-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
