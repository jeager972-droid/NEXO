import * as THREE from 'three'
import gsap from 'gsap'

// ─── Sand storm shader ─────────────────────────────────────────────────────────
// 8 000 GPU particles drifting left→right at high speed.
// All position math is in the vertex shader — zero CPU updates per frame.
const SAND_VS = /* glsl */`
  attribute float aOffset;  // per-particle random phase [0, 1]
  attribute float aSize;    // per-particle point size multiplier

  uniform float uTime;

  const float SPEED = 0.32;     // field traversals per second
  const float LEFT  = -16.0;    // spawn edge
  const float RIGHT =  16.0;    // die edge

  void main() {
    float cycle = fract(uTime * SPEED + aOffset);

    vec3 pos;
    pos.x = mix(LEFT, RIGHT, cycle);
    // position.y = random initial height (set at CPU init)
    pos.y = position.y + sin(cycle * 6.28318 + aOffset * 5.0) * 0.28;
    pos.z = position.z;  // random depth spread

    vec4 mvPos   = modelViewMatrix * vec4(pos, 1.0);
    gl_PointSize = aSize * (200.0 / -mvPos.z);
    gl_Position  = projectionMatrix * mvPos;
  }
`
const SAND_FS = /* glsl */`
  uniform float uOpacity;
  void main() {
    float d     = length(gl_PointCoord - vec2(0.5));
    if (d > 0.5) discard;
    float alpha = smoothstep(0.5, 0.15, d) * uOpacity;
    // Warm ochre / sand colour — slightly HDR for bloom catch
    gl_FragColor = vec4(1.05, 0.78, 0.38, alpha);
  }
`

// ─── Helpers ──────────────────────────────────────────────────────────────────

function buildSandGeometry(count) {
  const pos    = new Float32Array(count * 3)
  const offset = new Float32Array(count)
  const size   = new Float32Array(count)

  for (let i = 0; i < count; i++) {
    pos[i * 3 + 0] = 0                          // X: driven by shader
    pos[i * 3 + 1] = (Math.random() - 0.5) * 5  // Y: random height
    pos[i * 3 + 2] = (Math.random() - 0.5) * 18 // Z: depth spread
    offset[i]      = Math.random()
    size[i]        = 1.2 + Math.random() * 2.8
  }

  const geo = new THREE.BufferGeometry()
  geo.setAttribute('position', new THREE.BufferAttribute(pos,    3))
  geo.setAttribute('aOffset',  new THREE.BufferAttribute(offset, 1))
  geo.setAttribute('aSize',    new THREE.BufferAttribute(size,   1))
  return geo
}

// Procedural IoT display texture — green neon on near-black substrate
function buildIoTTexture() {
  const W = 512, H = 256
  const cv = document.createElement('canvas')
  cv.width = W; cv.height = H
  const ctx = cv.getContext('2d')

  ctx.fillStyle = '#000912'
  ctx.fillRect(0, 0, W, H)

  // Subtle grid (PCB aesthetic)
  ctx.strokeStyle = 'rgba(0, 255, 80, 0.07)'
  ctx.lineWidth = 1
  for (let x = 0; x < W; x += 24) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke()
  }
  for (let y = 0; y < H; y += 24) {
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke()
  }

  // IoT wordmark — oversized, glow shadow
  ctx.textAlign    = 'center'
  ctx.textBaseline = 'middle'
  ctx.shadowColor  = '#00ff55'
  ctx.shadowBlur   = 20
  ctx.fillStyle    = '#00ff55'
  ctx.font         = 'bold 80px monospace'
  ctx.fillText('IoT', W / 2, H * 0.36)

  // NEXO sub-label
  ctx.font        = 'bold 22px monospace'
  ctx.shadowBlur  = 10
  ctx.fillText('NEXO · SECURE', W / 2, H * 0.61)

  // Certification line
  ctx.font       = '14px monospace'
  ctx.shadowBlur = 6
  ctx.fillStyle  = '#00cc44'
  ctx.fillText('AES-256 · IP66 · CERTIFICADO', W / 2, H * 0.80)

  const tex = new THREE.CanvasTexture(cv)
  tex.colorSpace = THREE.SRGBColorSpace
  return tex
}

// Name hints for screen mesh detection in nodo.glb
const SCREEN_HINTS = [
  'screen', 'display', 'lcd', 'oled', 'panel', 'pantalla',
  'monitor', 'glass', 'window', 'face', 'front',
]

// ─── DesiertoScene ────────────────────────────────────────────────────────────
export class DesiertoScene {
  /**
   * @param {{
   *   scene:    THREE.Scene,
   *   renderer: THREE.WebGLRenderer,
   *   composer: EffectComposer & { bloom, heatHaze },
   *   assets:   Record<string, any>,
   *   matCtrl:  MaterialController,
   * }} params
   */
  constructor({ scene, renderer, composer, assets, matCtrl }) {
    this._scene    = scene
    this._renderer = renderer
    this._composer = composer
    this._assets   = assets
    this._matCtrl  = matCtrl

    this._sand        = null   // THREE.Mesh — sand floor
    this._storm       = null   // THREE.Points — sand particles
    this._sunLight    = null   // THREE.DirectionalLight
    this._screenMesh  = null   // nodo screen mesh reference
    this._screenOrig  = null   // material before IoT swap
    this._screenIoT   = null   // IoT emissive material

    this._active        = false
    this._savedBg       = null
    this._savedEnv      = null
    this._savedExposure = 1.0
  }

  // ── Async build: loads PBR textures, falls back gracefully ──────────────────
  async build() {
    await this._setupSandFloor()
    this._setupSandStorm()
    this._setupSunLight()
    this._setupIoTScreen()
    this._setVisible(false)
    console.info('[DesiertoScene] ✓ Built — sand floor, 8k storm particles, IoT screen, sun')
  }

  // ── Sand floor (procedural textures) ───────────────────────────────────────────
  async _setupSandFloor() {
    const BASE   = 'assets/texturas-arena/'
    const loader = new THREE.TextureLoader()

    const loadTexture = (file) => new Promise(resolve => {
      loader.load(BASE + file, tex => resolve(tex), undefined, () => resolve(null))
    })

    const [colorMap, normalMap, roughnessMap] = await Promise.all([
      loadTexture('Ground080_2K-JPG_Color.jpg'),
      loadTexture('Ground080_2K-JPG_NormalGL.jpg'),
      loadTexture('Ground080_2K-JPG_Roughness.jpg'),
    ])

    const geo = new THREE.PlaneGeometry(240, 240)

    if (colorMap && normalMap && roughnessMap) {
      colorMap.wrapS = colorMap.wrapT = THREE.RepeatWrapping
      normalMap.wrapS = normalMap.wrapT = THREE.RepeatWrapping
      roughnessMap.wrapS = roughnessMap.wrapT = THREE.RepeatWrapping

      colorMap.repeat.set(6, 6)
      normalMap.repeat.set(6, 6)
      roughnessMap.repeat.set(6, 6)

      const mat = new THREE.MeshStandardMaterial({
        color:        0xffffff,
        map:          colorMap,
        normalMap:    normalMap,
        roughnessMap: roughnessMap,
        roughness:    1.0,
        metalness:    0.0,
      })
      this._sand = new THREE.Mesh(geo, mat)
      console.info('[DesiertoScene] Sand floor loaded with PBR textures')
    } else {
      // Fallback: solid sand colour if textures fail — scene keeps working
      const mat = new THREE.MeshStandardMaterial({
        color:     0xcaa07a,
        roughness: 1.0,
        metalness: 0.0,
      })
      this._sand = new THREE.Mesh(geo, mat)
      console.warn('[DesiertoScene] Ground080 textures missing — using fallback sand colour')
    }

    this._sand.rotation.x = -Math.PI / 2
    this._sand.position.y = -1.62
    this._scene.add(this._sand)
  }

  // ── GPU sand storm particles ─────────────────────────────────────────────────
  _setupSandStorm() {
    const mat = new THREE.ShaderMaterial({
      vertexShader:   SAND_VS,
      fragmentShader: SAND_FS,
      uniforms: {
        uTime:    { value: 0 },
        uOpacity: { value: 0 },
      },
      transparent: true,
      depthWrite:  false,
      blending:    THREE.AdditiveBlending,
    })
    this._storm = new THREE.Points(buildSandGeometry(8000), mat)
    this._scene.add(this._storm)
  }

  // ── Sun light (intense desert sun) ───────────────────────────────────────────────
  _setupSunLight() {
    const sun = new THREE.DirectionalLight(0xffffff, 2.5)
    sun.position.set(-30, 40, -20)
    sun.castShadow = true
    sun.shadow.mapSize.width = 2048
    sun.shadow.mapSize.height = 2048
    sun.shadow.camera.near = 0.5
    sun.shadow.camera.far = 100
    sun.shadow.camera.left = -30
    sun.shadow.camera.right = 30
    sun.shadow.camera.top = 30
    sun.shadow.camera.bottom = -30
    this._scene.add(sun)
  }

  // ── IoT screen — find by name hints, swap to emissive material on enter ──────
  _setupIoTScreen() {
    const gltf = this._assets.nodo
    if (!gltf) return

    let found = null
    gltf.scene.traverse(child => {
      if (found || !child.isMesh) return
      const name = child.name.toLowerCase()
      if (SCREEN_HINTS.some(h => name.includes(h))) found = child
    })

    if (!found) {
      console.warn('[DesiertoScene] No screen mesh found in nodo.glb — IoT effect skipped')
      console.info('[DesiertoScene] nodo.glb mesh names:', (() => {
        const names = []
        gltf.scene.traverse(c => { if (c.isMesh) names.push(c.name) })
        return names
      })())
      return
    }

    this._screenMesh = found
    this._screenOrig = found.material
    console.info(`[DesiertoScene] IoT screen mesh: "${found.name}"`)

    this._screenIoT = new THREE.MeshStandardMaterial({
      color:             new THREE.Color(0x000000),
      emissive:          new THREE.Color(0x00ff55),
      emissiveMap:       buildIoTTexture(),
      emissiveIntensity: 0,          // tweened to 5.0 on enter
      roughness:         0.05,
      metalness:         0.0,
      envMapIntensity:   0,
    })
  }

  // ── Environment crossfade (same pattern as other scenes) ─────────────────────
  _swapEnv(newEnv, targetIntensity) {
    const can = 'environmentIntensity' in this._scene
    const swap = () => {
      this._scene.environment = newEnv
      if (can) gsap.to(this._scene, { environmentIntensity: targetIntensity, duration: 0.9 })
    }
    if (can) gsap.to(this._scene, { environmentIntensity: 0, duration: 0.5,
      ease: 'power2.in', onComplete: swap })
    else swap()
  }

  // ── Batch visibility ─────────────────────────────────────────────────────────
  _setVisible(v) {
    if (this._sand)     this._sand.visible     = v
    if (this._storm)    this._storm.visible    = v
    if (this._sunLight) this._sunLight.visible = v
  }

  // ── Section lifecycle ─────────────────────────────────────────────────────────
  enter() {
    if (this._active) return
    this._active = true

    this._savedBg       = this._scene.background
    this._savedEnv      = this._scene.environment
    this._savedExposure = this._renderer.toneMappingExposure

    // Desert env + overexposed bright sun
    const desiertoEnv = this._assets.desiertoEnv ?? this._savedEnv
    this._swapEnv(desiertoEnv, 1.40)
    gsap.to(this._renderer, { toneMappingExposure: 1.30, duration: 1.5, ease: 'power2.inOut' })

    // Lens drip cleanup (fade to 0 if still showing from Stage 5)
    // ResistenciaScene.leave() handles this via SectionManager; this is a safety net
    this._scene.traverse(child => {
      if (child.isMesh && child.renderOrder === 999 && child.material?.opacity > 0) {
        gsap.to(child.material, { opacity: 0, duration: 0.4, ease: 'power2.in' })
      }
    })

    this._setVisible(true)

    // Fade in sand storm
    gsap.to(this._storm.material.uniforms.uOpacity, { value: 0.70, duration: 1.4, ease: 'power2.out' })

    // Heat haze: enable then tween intensity
    if (this._composer?.heatHaze) {
      this._composer.heatHaze.enabled = true
      gsap.to(this._composer.heatHaze.uniforms.uIntensity, { value: 1.0, duration: 1.8, ease: 'power2.out' })
    }

    // Hot material: roughness → 0.88 / metalness stays (sand abrasion)
    this._matCtrl.setHot()

    // IoT screen activation
    if (this._screenMesh && this._screenIoT) {
      this._screenMesh.material = this._screenIoT
      gsap.to(this._screenIoT, { emissiveIntensity: 5.0, duration: 1.2, ease: 'power3.out' })
    }
  }

  leave() {
    if (!this._active) return
    this._active = false

    // Restore env + exposure
    this._swapEnv(this._savedEnv, 1.2)
    this._scene.background = this._savedBg
    gsap.to(this._renderer, { toneMappingExposure: this._savedExposure, duration: 1.0 })

    // Kill heat haze
    if (this._composer?.heatHaze) {
      gsap.to(this._composer.heatHaze.uniforms.uIntensity, { value: 0, duration: 0.8,
        onComplete: () => { this._composer.heatHaze.enabled = false } })
    }

    // Fade out sand storm + hide
    gsap.to(this._storm.material.uniforms.uOpacity, { value: 0, duration: 0.8, ease: 'power2.in',
      onComplete: () => this._setVisible(false) })

    // IoT screen off
    if (this._screenMesh && this._screenIoT) {
      gsap.to(this._screenIoT, { emissiveIntensity: 0, duration: 0.5, ease: 'power2.in',
        onComplete: () => {
          if (this._screenMesh) this._screenMesh.material = this._screenOrig
        },
      })
    }

    // Restore PBR to dry
    this._matCtrl.setDry()
  }

  // ── Tick — advance sand shader clock + heatHaze time ────────────────────────
  tick(t) {
    if (!this._active) return

    this._storm.material.uniforms.uTime.value = t

    if (this._composer?.heatHaze?.enabled) {
      this._composer.heatHaze.uniforms.uTime.value = t
    }
  }

  // ── Cleanup ───────────────────────────────────────────────────────────────────
  dispose() {
    this._sand?.geometry.dispose()
    this._sand?.material.map?.dispose()
    this._sand?.material.normalMap?.dispose()
    this._sand?.material.roughnessMap?.dispose()
    this._sand?.material.dispose()
    this._storm?.geometry.dispose()
    this._storm?.material.dispose()
    this._screenIoT?.emissiveMap?.dispose()
    this._screenIoT?.dispose()
  }
}
