import * as THREE from 'three'
import gsap from 'gsap'

// ─── GPU Beam shader ───────────────────────────────────────────────────────────
// Particles stream from phone → nodo → sky continuously while in State 2.
// Positions are fully computed from uniforms — the position attribute is a no-op placeholder.
const BEAM_VS = /* glsl */`
  attribute float aOffset;

  uniform float uPhase;     // advances 0→∞; fract() creates infinite loop
  uniform vec3  uA;         // phone screen world position
  uniform vec3  uB;         // nodo center
  uniform vec3  uC;         // sky vanishing point

  void main() {
    float t = fract(aOffset + uPhase);

    vec3 pos;
    if (t < 0.50) {
      pos = mix(uA, uB, smoothstep(0.0, 1.0, t * 2.0));
    } else {
      pos = mix(uB, uC, smoothstep(0.0, 1.0, (t - 0.50) * 2.0));
    }

    // Radial scatter = organic beam thickness
    float ang = aOffset * 43.758 * 6.28318;
    pos.x += cos(ang) * 0.022;
    pos.z += sin(ang) * 0.022;

    vec4 mvPos   = modelViewMatrix * vec4(pos, 1.0);
    gl_PointSize = 4.0 * (300.0 / -mvPos.z);
    gl_Position  = projectionMatrix * mvPos;
  }
`
const BEAM_FS = /* glsl */`
  uniform float uOp;
  void main() {
    float d = length(gl_PointCoord - vec2(0.5));
    if (d > 0.5) discard;
    // HDR NEXO green — overbright so bloom catches it
    gl_FragColor = vec4(0.20, 1.35, 0.50, smoothstep(0.5, 0.10, d) * uOp);
  }
`

// ─── Canvas dimensions ─────────────────────────────────────────────────────────
const CW = 512
const CH = 1024

// ─── Canvas helpers ────────────────────────────────────────────────────────────
const G = '#00c875'   // NEXO green
const D = '#0a0e1a'   // dark bg

function rrect(ctx, x, y, w, h, r) {
  ctx.beginPath()
  ctx.moveTo(x + r, y)
  ctx.lineTo(x + w - r, y); ctx.arcTo(x + w, y,     x + w, y + r,     r)
  ctx.lineTo(x + w, y + h - r); ctx.arcTo(x + w, y + h, x + w - r, y + h, r)
  ctx.lineTo(x + r, y + h); ctx.arcTo(x,     y + h, x,     y + h - r, r)
  ctx.lineTo(x, y + r); ctx.arcTo(x, y, x + r, y, r)
  ctx.closePath()
}

function statusBar(ctx) {
  ctx.fillStyle = '#070b14'
  ctx.fillRect(0, 0, CW, 50)
  ctx.fillStyle = '#e8eeff'
  ctx.font      = 'bold 22px system-ui'
  ctx.textAlign = 'left'; ctx.textBaseline = 'middle'
  ctx.fillText('9:41', 28, 25)
  ctx.textAlign = 'right'
  ctx.fillText('⚡ 100%', CW - 28, 25)
}

// ─── State 0 — Dashboard ───────────────────────────────────────────────────────
function drawDashboard(ctx) {
