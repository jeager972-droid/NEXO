    ctx.fillStyle = 'rgba(255,255,255,0.09)'
    rrect(ctx, 40, y + 14, CW - 80, 66, 10); ctx.fill()
    ctx.strokeStyle = 'rgba(0,200,117,0.25)'; ctx.lineWidth = 1.5
    rrect(ctx, 40, y + 14, CW - 80, 66, 10); ctx.stroke()
