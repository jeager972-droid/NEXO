import * as THREE from 'three'

// ─── PBR Presets ──────────────────────────────────────────────────────────────
// Industrial plastic chassis: matte, absorbs light, low reflectance
const PRESET_PLASTIC = { metalness: 0.0, roughness: 0.70, envMapIntensity: 0.75 }
// Metal hardware / sensors: mirror-like, strong specular, edge highlights
const PRESET_METAL   = { metalness: 1.0, roughness: 0.15, envMapIntensity: 1.50 }

// ─── Classification hints ─────────────────────────────────────────────────────
const METAL_HINTS   = ['metal', 'sensor', 'pin', 'connector', 'pcb', 'board',
                        'chip', 'copper', 'gold', 'steel', 'alum', 'screw',
                        'bolt', 'trace', 'antenna', 'port', 'usb', 'led']
const PLASTIC_HINTS = ['body', 'case', 'chassis', 'housing', 'cover', 'plastic',
                        'shell', 'enclosure', 'base', 'lid', 'frame', 'mount']

// ─── Helpers ──────────────────────────────────────────────────────────────────
function classifyMaterial(meshName, matName, originalMetalness) {
  const tokens = `${meshName} ${matName}`.toLowerCase()
  if (METAL_HINTS.some(h => tokens.includes(h)))   return 'metal'
  if (PLASTIC_HINTS.some(h => tokens.includes(h))) return 'plastic'
  return originalMetalness >= 0.5 ? 'metal' : 'plastic'
}

function fitModel(model, targetSize) {
  const box    = new THREE.Box3().setFromObject(model)
  const maxDim = box.getSize(new THREE.Vector3()).length()
  if (maxDim > 0) model.scale.setScalar(targetSize / maxDim)
}

/**
 * Apply a PBR preset. Ignores broken GLB extensions and creates a fresh
 * MeshStandardMaterial so the mesh is guaranteed visible.
 *
 * @param {THREE.Mesh}          child
 * @param {MaterialController?} mc
 */
function applyMaterials(child, mc) {
  const mat = new THREE.MeshStandardMaterial({
    color:     0xbbbbbb,
    roughness: 0.5,
    metalness: 0.8,
  })
  child.material = mat
  if (mc) mc.registerMetal(mat)
}

// ─── Gradient background ──────────────────────────────────────────────────────
/**
 * Creates a premium grey/green cinematic background as a CanvasTexture.
 * Radial focal point aligns with the heroic camera angle (upper-right).
 */
function createGradientBackground() {
  const SIZE = 512
  const cv   = document.createElement('canvas')
  cv.width   = SIZE
  cv.height  = SIZE
  const ctx  = cv.getContext('2d')

  // ── Layer 1: deep near-black charcoal base ─────────────────────────────────
  ctx.fillStyle = '#060a08'
  ctx.fillRect(0, 0, SIZE, SIZE)

  // ── Layer 2: deep-green radial focal glow (upper-right = camera side) ──────
  const g1 = ctx.createRadialGradient(
    SIZE * 0.66, SIZE * 0.36, 0,
    SIZE * 0.50, SIZE * 0.50, SIZE * 0.72,
  )
  g1.addColorStop(0.00, 'rgba(18, 62, 40,  0.92)')
  g1.addColorStop(0.35, 'rgba(10, 32, 20,  0.60)')
  g1.addColorStop(0.75, 'rgba(5,  14,  9,  0.25)')
  g1.addColorStop(1.00, 'rgba(2,   5,  3,  0.00)')
  ctx.fillStyle = g1
  ctx.fillRect(0, 0, SIZE, SIZE)

  // ── Layer 3: secondary warm-grey counter-glow (lower-left) ─────────────────
  const g2 = ctx.createRadialGradient(
    SIZE * 0.18, SIZE * 0.80, 0,
    SIZE * 0.25, SIZE * 0.75, SIZE * 0.45,
  )
  g2.addColorStop(0.00, 'rgba(30, 32, 30,  0.20)')
  g2.addColorStop(1.00, 'rgba(0,   0,  0,  0.00)')
  ctx.fillStyle = g2
  ctx.fillRect(0, 0, SIZE, SIZE)

  // ── Layer 4: edge vignette ─────────────────────────────────────────────────
  const g3 = ctx.createRadialGradient(
    SIZE * 0.50, SIZE * 0.50, SIZE * 0.15,
    SIZE * 0.50, SIZE * 0.50, SIZE * 0.92,
  )
  g3.addColorStop(0.00, 'rgba(0,0,0, 0.00)')
  g3.addColorStop(1.00, 'rgba(0,0,0, 0.60)')
  ctx.fillStyle = g3
  ctx.fillRect(0, 0, SIZE, SIZE)

  const tex = new THREE.CanvasTexture(cv)
  tex.colorSpace = THREE.SRGBColorSpace
  return tex
}

// ─── HeroScene ────────────────────────────────────────────────────────────────
export class HeroScene {
  /**
   * @param {{
   *   scene:    THREE.Scene,
   *   camera:   THREE.PerspectiveCamera,
   *   controls: import('three/examples/jsm/controls/OrbitControls').OrbitControls,
   *   assets:   Record<string, any>
   * }} params
   */
  /**
   * @param {materialController} optional MaterialController — when provided,
   * all classified materials are registered for Stage 5/6 roughness tweens.
   */
  constructor({ scene, camera, controls, assets, materialController = null }) {
    this._scene              = scene
    this._camera             = camera
    this._controls           = controls
    this._assets             = assets
    this._materialController = materialController
  }

  build() {
    this._setupBackground()
    this._setupIBL()
    this._setupLights()
    this._setupModel()
    this._setupCamera()
    this._setupControls()
    console.info('[HeroScene] ✓ Build complete')
  }

  // ── Background gradient ─────────────────────────────────────────────────────
  _setupBackground() {
    this._scene.background = createGradientBackground()
  }

  // ── IBL — studio_small_08_2k.exr at intensity 1.2 ──────────────────────────
  _setupIBL() {
    const env = this._assets.studioEnv
    if (!env) {
      console.warn('[HeroScene] studioEnv missing — IBL skipped')
      return
    }

    this._scene.environment = env

    // Three.js r163+ global env multiplier
    if ('environmentIntensity' in this._scene) {
      this._scene.environmentIntensity = 1.2
    }
  }

  // ── Base lighting — always present, independent of IBL ────────────────────────
  _setupLights() {
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.5)
    this._scene.add(ambientLight)

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.5)
    dirLight.position.set(5, 10, 5)
    this._scene.add(dirLight)
  }

  // ── Model ───────────────────────────────────────────────────────────────────
  _setupModel() {
    const gltf = this._assets.nodo
    if (!gltf) {
      console.error('[HeroScene] nodo.glb not loaded')
      return
    }

    const model = gltf.scene

    // ── PBR material pass ────────────────────────────────────────────────────
    model.traverse((child) => {
      if (!child.isMesh || !child.material) return
      child.castShadow    = true
      child.receiveShadow = true
      applyMaterials(child, this._materialController)
    })

    // ── Auto-fit to target size (60% of screen) ───────────────────────────────
    const box    = new THREE.Box3().setFromObject(model)
    const maxDim = box.getSize(new THREE.Vector3()).length()
    const center = box.getCenter(new THREE.Vector3())

    if (maxDim > 0) {
      const s = 2.0 / maxDim
      model.scale.setScalar(s)
      model.position.copy(center).multiplyScalar(-s)
      // Stage 9 Fix: Position nodo to the right side of frame for Hero layout
      model.position.x += 1.4
      console.info(`[HeroScene] nodo.glb normalized — original max: ${maxDim.toFixed(3)} → scale: ${s.toFixed(4)}, pos: ${model.position.x.toFixed(2)}`)
    }
  }

  // ── Camera — heroic 3/4 angle, right-of-center, slight elevation ────────────
  _setupCamera() {
    this._camera.position.set(2.1, 1.25, 4.4)
    this._camera.updateProjectionMatrix()
  }

  // ── Controls ─────────────────────────────────────────────────────────────────
  _setupControls() {
    const ctrl = this._controls

    // Offset target slightly left to compensate for camera being on the right
    ctrl.target.set(-0.22, 0.05, 0)
    ctrl.update()

    ctrl.autoRotate      = true
    ctrl.autoRotateSpeed = 0.25      // ≈ 240 seconds / full orbit — ultra-smooth
    ctrl.enableDamping   = true
    ctrl.dampingFactor   = 0.035     // slightly smoother than default

    // Horizontal: full 360° user rotation allowed
    // Vertical: clamp to prevent flipping or ground-plane view
    ctrl.minPolarAngle = Math.PI * 0.18   // ~32° — heroic top angle
    ctrl.maxPolarAngle = Math.PI * 0.58   // ~104° — slight low angle max

    ctrl.enableZoom = false
    ctrl.enablePan  = false
  }

  // ── Cleanup (Stage 9) ─────────────────────────────────────────────────────────
  dispose() {
    // Dispose the gradient background texture
    if (this._scene.background && this._scene.background.isTexture) {
      this._scene.background.dispose()
      this._scene.background = null
    }
  }
}
