// ─── Beam geometry builder ─────────────────────────────────────────────────────
function buildBeamGeo(count) {
  const pos     = new Float32Array(count * 3)   // placeholder — computed in VS
  const offsets = new Float32Array(count)
  for (let i = 0; i < count; i++) offsets[i] = Math.random()
  const geo = new THREE.BufferGeometry()
  geo.setAttribute('position', new THREE.BufferAttribute(pos,     3))
  geo.setAttribute('aOffset',  new THREE.BufferAttribute(offsets, 1))
  return geo
}

// ─── AppScene ─────────────────────────────────────────────────────────────────
export class AppScene {
  /**
   * @param {{
   *   scene:    THREE.Scene,
   *   camera:   THREE.PerspectiveCamera,
   *   renderer: THREE.WebGLRenderer,
   *   composer: EffectComposer & { bloom },
   *   assets:   Record<string, any>,
   * }} params
   */
  constructor({ scene, camera, renderer, composer, assets }) {
    this._scene    = scene
    this._camera   = camera
    this._renderer = renderer
    this._composer = composer
    this._assets   = assets

    this._phoneGroup  = null   // phone model group
    this._screenMesh  = null   // raycaster target (PlaneGeometry)
    this._screenTex   = null   // CanvasTexture
    this._screenCtx   = null   // Canvas2D context
    this._beam        = null   // GPU beam Points

    this._state          = 0
    this._transmissionT  = 0
    this._lastT          = 0
    this._active         = false

    this._savedEnv      = null
    this._savedExposure = 1.0
    this._onClick       = null  // bound click handler (managed by enter/leave)

    // Phone home transform (for idle animation)
    this._phoneBaseY    = 0.30
    this._phoneBaseRotY = -0.20
  }

  // ── Build ──────────────────────────────────────────────────────────────────────
  build() {
    this._buildPhone()
    this._buildBeam()
    this._setVisible(false)
    console.info('[AppScene] ✓ Built — procedural phone, 4-state CanvasTexture UI, GPU beam')
  }

  // ── Procedural premium smartphone ─────────────────────────────────────────────
  _buildPhone() {
    this._phoneGroup = new THREE.Group()
    this._phoneGroup.position.set(1.40, this._phoneBaseY, 2.50)
    this._phoneGroup.rotation.set(-0.04, this._phoneBaseRotY, 0.00)

    // Body — dark anodized titanium
    const body = new THREE.Mesh(
      new THREE.BoxGeometry(1.15, 2.35, 0.12),
      new THREE.MeshStandardMaterial({
        color:          0x181820,
        metalness:      0.88,
        roughness:      0.10,
        emissive:       new THREE.Color(0.04, 0.04, 0.06),
        emissiveIntensity: 1,
        envMapIntensity: 1.2,
      }),
    )
    body.castShadow = true

    // Screen canvas texture
    const cv  = document.createElement('canvas')
    cv.width  = CW; cv.height = CH
    const ctx = cv.getContext('2d')
    this._screenCtx = ctx
    drawDashboard(ctx)

    const tex = new THREE.CanvasTexture(cv)
    tex.colorSpace = THREE.SRGBColorSpace
    this._screenTex = tex

    const screen = new THREE.Mesh(
      new THREE.PlaneGeometry(0.96, 1.92),
      new THREE.MeshStandardMaterial({
        map:               tex,
        emissiveMap:       tex,
        emissive:          new THREE.Color(1, 1, 1),
        emissiveIntensity: 1.20,   // screen is self-lit
        roughness:         0.05,
        metalness:         0.00,
        envMapIntensity:   0,
      }),
    )
    screen.position.z = 0.065   // front face of body
    this._screenMesh = screen

    // Front camera dot
    const dot = new THREE.Mesh(
      new THREE.CircleGeometry(0.025, 12),
      new THREE.MeshStandardMaterial({ color: 0x080808, roughness: 0.2, metalness: 0.9 }),
    )
    dot.position.set(0, 1.01, 0.068)

    // Home indicator pill
    const pill = new THREE.Mesh(
      new THREE.BoxGeometry(0.22, 0.018, 0.005),
      new THREE.MeshStandardMaterial({ color: 0x404050, roughness: 0.4, metalness: 0.6 }),
    )
    pill.position.set(0, -0.94, 0.068)

    this._phoneGroup.add(body, screen, dot, pill)
    this._scene.add(this._phoneGroup)
  }

  // ── GPU beam ──────────────────────────────────────────────────────────────────
  _buildBeam() {
    const mat = new THREE.ShaderMaterial({
      vertexShader:   BEAM_VS,
      fragmentShader: BEAM_FS,
      uniforms: {
        uPhase: { value: 0 },
        uOp:    { value: 0 },
        uA:     { value: new THREE.Vector3(1.50, 0.30, 2.565) },  // phone screen
        uB:     { value: new THREE.Vector3(0.00, 0.50, 0.000) },  // nodo
        uC:     { value: new THREE.Vector3(-0.5, 9.00, -4.00) },  // sky/cloud
      },
      transparent: true,
      depthWrite:  false,
      blending:    THREE.AdditiveBlending,
    })
    this._beam = new THREE.Points(buildBeamGeo(240), mat)
    this._beam.visible = false
    this._scene.add(this._beam)
  }

  // ── Visibility ────────────────────────────────────────────────────────────────
  _setVisible(v) {
    if (this._phoneGroup) this._phoneGroup.visible = v
  }

  // ── Section lifecycle ─────────────────────────────────────────────────────────
  enter() {
    if (this._active) return
    this._active = true

    this._savedEnv      = this._scene.environment
    this._savedExposure = this._renderer.toneMappingExposure

    // Studio env — crisp presentation lighting
    const env = this._assets.studioEnv ?? this._savedEnv
    if ('environmentIntensity' in this._scene) {
      gsap.to(this._scene, { environmentIntensity: 1.2, duration: 0.8 })
    }
    this._scene.environment = env
    gsap.to(this._renderer, { toneMappingExposure: 0.95, duration: 0.8 })

    // Bloom: gentle for clean product shot
    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 0.40, duration: 0.6 })
    }

    // Reset to State 0
    this._setState(0)

    // Phone pop entrance
    this._setVisible(true)
    this._phoneGroup.scale.setScalar(0.5)
    gsap.to(this._phoneGroup.scale, { x: 1, y: 1, z: 1, duration: 0.65, ease: 'back.out(1.6)' })

    // Register click handler (AppScene owns its own events)
    this._onClick = (e) => this.handleClick(e)
    this._renderer.domElement.addEventListener('click', this._onClick)
  }

  leave() {
    if (!this._active) return
    this._active = false

    this._renderer.domElement.removeEventListener('click', this._onClick)
    this._onClick = null

    if ('environmentIntensity' in this._scene) {
      gsap.to(this._scene, { environmentIntensity: 1.0, duration: 0.6 })
    }
    this._scene.environment = this._savedEnv
    gsap.to(this._renderer, { toneMappingExposure: this._savedExposure, duration: 0.8 })
    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 0.50, duration: 0.5 })
    }

    gsap.to(this._phoneGroup.scale, { x: 0, y: 0, z: 0, duration: 0.35, ease: 'power3.in',
      onComplete: () => this._setVisible(false) })

    this._beam.visible = false
    this._transmissionT = 0
  }

  // ── Click detection via Raycaster ─────────────────────────────────────────────
  handleClick(event) {
    if (!this._active || this._state === 2) return

    const canvas = this._renderer.domElement
    const rect   = canvas.getBoundingClientRect()
    const ndc    = new THREE.Vector2(
      ((event.clientX - rect.left) / rect.width)  * 2 - 1,
      -((event.clientY - rect.top)  / rect.height) * 2 + 1,
    )

    const ray  = new THREE.Raycaster()
    ray.setFromCamera(ndc, this._camera)

    const hits = ray.intersectObject(this._screenMesh)
    if (!hits.length) return

    // Bottom 22% of screen (UV.y < 0.22) = button area
    // Three.js PlaneGeometry UV.y: 0=bottom, 1=top; canvas.y: 0=top (flipY)
    const uv = hits[0].uv
    if (uv && uv.y < 0.22) {
      this._advanceState()
    }
  }

  // ── State machine ─────────────────────────────────────────────────────────────
  _advanceState() {
    if (this._state === 0) this._setState(1)
    else if (this._state === 1) this._setState(2)
    else if (this._state === 3) this._setState(0)
    // State 2 is auto-timed — clicks ignored
  }

  _setState(n) {
    this._state         = n
    this._transmissionT = 0

    if (n === 2) {
      // Activate beam
      this._beam.visible = true
      this._beam.material.uniforms.uOp.value = 0
      gsap.to(this._beam.material.uniforms.uOp, { value: 0.75, duration: 0.6 })
      // Boost bloom for data-stream glow
      if (this._composer?.bloom) {
        gsap.to(this._composer.bloom, { strength: 0.90, duration: 0.5 })
      }
    } else {
      // Deactivate beam
      gsap.to(this._beam.material.uniforms.uOp, { value: 0, duration: 0.4,
        onComplete: () => { this._beam.visible = false } })
      if (this._composer?.bloom) {
        gsap.to(this._composer.bloom, { strength: 0.40, duration: 0.5 })
      }
    }

    if (n === 3) {
      this._playNotificationTone()
    }

    this._updateScreen()
  }

  // ── Canvas redraw ─────────────────────────────────────────────────────────────
  _updateScreen(progress = 0) {
    const ctx = this._screenCtx
    switch (this._state) {
      case 0: drawDashboard(ctx);              break
      case 1: drawForm(ctx);                   break
      case 2: drawTransmission(ctx, progress); break
      case 3: drawWhatsApp(ctx);               break
    }
    this._screenTex.needsUpdate = true
  }

  // ── Web Audio notification tone (no file dependency) ──────────────────────────
  _playNotificationTone() {
    try {
      const Ctx  = window.AudioContext || window.webkitAudioContext
      const actx = new Ctx()
      ;[[0.00, 880], [0.14, 1320], [0.28, 1100]].forEach(([t, freq]) => {
        const osc  = actx.createOscillator()
        const gain = actx.createGain()
        osc.connect(gain); gain.connect(actx.destination)
        osc.frequency.value = freq; osc.type = 'sine'
        gain.gain.setValueAtTime(0, actx.currentTime + t)
        gain.gain.linearRampToValueAtTime(0.12, actx.currentTime + t + 0.012)
        gain.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + t + 0.32)
        osc.start(actx.currentTime + t)
        osc.stop(actx.currentTime + t + 0.35)
      })
    } catch { /* Browser may block AudioContext without user gesture — silently ignored */ }
  }

  // ── Tick — phone idle animation + transmission progress ───────────────────────
  tick(t) {
    const dt = this._lastT > 0 ? Math.min(t - this._lastT, 0.05) : 0.016
    this._lastT = t
    if (!this._active) return

    // Idle phone float + gentle rock
    if (this._phoneGroup) {
      this._phoneGroup.position.y = this._phoneBaseY + Math.sin(t * 0.72) * 0.038
      this._phoneGroup.rotation.y = this._phoneBaseRotY + Math.sin(t * 0.28) * 0.048
    }

    // State 2: advance beam phase + update transmission canvas
    if (this._state === 2) {
      this._transmissionT += dt
      const progress = Math.min(this._transmissionT / 2.8, 1.0)

      // Advance beam phase continuously
      this._beam.material.uniforms.uPhase.value = this._transmissionT * 0.55

      // Redraw canvas with updated progress bar
      this._updateScreen(progress)

      // Auto-advance to WhatsApp when transmission completes
      if (this._transmissionT >= 3.0) {
        this._setState(3)
      }
    }
  }

  // ── Cleanup ───────────────────────────────────────────────────────────────────
  dispose() {
    if (this._onClick) {
      this._renderer.domElement.removeEventListener('click', this._onClick)
    }
    this._phoneGroup?.traverse(c => {
      c.geometry?.dispose()
      if (c.material) {
        c.material.map?.dispose()
        c.material.emissiveMap?.dispose()
        c.material.dispose()
      }
    })
    this._screenTex?.dispose()
    this._beam?.geometry.dispose()
    this._beam?.material.dispose()
  }
}
