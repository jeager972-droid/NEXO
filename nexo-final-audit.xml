import * as THREE from 'three'
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'
import { EXRLoader }  from 'three/examples/jsm/loaders/EXRLoader.js'
import { RGBELoader } from 'three/examples/jsm/loaders/RGBELoader.js'

// ─── Asset Manifest ────────────────────────────────────────────────────────────
const MANIFEST = {
  models: [
    { key: 'nodo',    url: 'assets/models/nodo.glb' },
    { key: 'planeta', url: 'assets/models/planeta.glb' },
    { key: 'roca',    url: 'assets/models/roca.glb' },
    { key: 'pared',   url: 'assets/models/pared.glb' },
  ],
  exr: [
    { key: 'studioEnv',   url: 'assets/environments/studio_small_08_2k.exr' },
    { key: 'desiertoEnv', url: 'assets/environments/studio_small_08_2k.exr' },
    { key: 'tormentaEnv', url: 'assets/environments/studio_small_08_2k.exr' },
  ],
  hdr: [], // Estrellas desactivado para evitar errores de formato
  textures: [
    { key: 'waterNormals', url: 'assets/waternormals.jpg', wrap: true },
  ],
}

// ─── AssetManager ──────────────────────────────────────────────────────────────
export class AssetManager {
  /**
   * @param {(url: string, loaded: number, total: number) => void} onProgress
   * @param {(assets: Record<string, any>) => void} onComplete
   * @param {(url: string, err: ErrorEvent) => void} onError
   */
  constructor(onProgress, onComplete, onError) {
    this.assets = {}

    this.manager = new THREE.LoadingManager(
      () => onComplete(this.assets),
      onProgress,
      onError,
    )

    this._gltf = new GLTFLoader(this.manager)
    this._exr  = new EXRLoader(this.manager)
    this._rgbe = new RGBELoader(this.manager)
    this._tex  = new THREE.TextureLoader(this.manager)
  }

  /**
   * Kick off all loads. Resolves with the populated assets map.
   * Missing files are soft-failed (warning logged, key absent).
   *
   * @param {THREE.WebGLRenderer} renderer   — needed to build PMREM env maps
   * @returns {Promise<Record<string, any>>}
   */
  loadAll(renderer) {
    const pmrem = new THREE.PMREMGenerator(renderer)
    pmrem.compileEquirectangularShader()

    const tasks = []

    // ── GLB Models ────────────────────────────────────────────────────────────
    for (const { key, url } of MANIFEST.models) {
      tasks.push(new Promise((resolve) => {
        this._gltf.load(
          url,
          (gltf) => { this.assets[key] = gltf; resolve() },
          undefined,
          (err)  => { console.error(`[AssetManager] Failed to load ${url}:`, err); resolve() },
        )
      }))
    }

    // ── EXR Environments → PMREM ──────────────────────────────────────────────
    for (const { key, url } of MANIFEST.exr) {
      tasks.push(new Promise((resolve) => {
        this._exr.load(
          url,
          (tex) => {
            tex.mapping = THREE.EquirectangularReflectionMapping
            this.assets[key] = pmrem.fromEquirectangular(tex).texture
            tex.dispose()
            resolve()
          },
          undefined,
          (err) => { console.error(`[AssetManager] Failed to load ${url}:`, err); resolve() },
        )
      }))
    }

    // ── HDR Environments → PMREM ──────────────────────────────────────────────
    for (const { key, url } of MANIFEST.hdr) {
      tasks.push(new Promise((resolve) => {
        this._rgbe.load(
          url,
          (tex) => {
            tex.mapping = THREE.EquirectangularReflectionMapping
            this.assets[key] = pmrem.fromEquirectangular(tex).texture
            tex.dispose()
            resolve()
          },
          undefined,
          (err) => { console.error(`[AssetManager] Failed to load ${url}:`, err); resolve() },
        )
      }))
    }

    // ── Flat Textures ─────────────────────────────────────────────────────────
    for (const { key, url, wrap } of MANIFEST.textures) {
      tasks.push(new Promise((resolve) => {
        this._tex.load(
          url,
          (tex) => {
            if (wrap) { tex.wrapS = tex.wrapT = THREE.RepeatWrapping }
            this.assets[key] = tex
            resolve()
          },
          undefined,
          (err) => { console.error(`[AssetManager] Failed to load ${url}:`, err); resolve() },
        )
      }))
    }

    return Promise.all(tasks).then(() => {
      pmrem.dispose()
      console.info('[AssetManager] All tasks settled. Keys:', Object.keys(this.assets))
      return this.assets
    })
  }
}
