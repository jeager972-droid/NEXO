import gsap from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

gsap.registerPlugin(ScrollTrigger)

// ─── Camera waypoints per section ─────────────────────────────────────────────
// px/py/pz = camera world position
// lx/ly/lz = controls.target / camera.lookAt point
export const WAYPOINTS = [
  { id: 'hero',
    px:  2.10, py:  1.25, pz:  4.40,
    lx: -0.22, ly:  0.05, lz:  0.00 },

  { id: 'usuarios',
    px: -0.30, py:  0.60, pz:  4.00,
    lx:  0.10, ly:  0.25, lz:  0.00 },

  // Cifrado: radical zoom-out to space — planet.glb enters Stage 4
  { id: 'cifrado',
    px:  0.00, py: 18.00, pz: 70.00,
    lx:  0.00, ly:  0.00, lz:  0.00 },

  // Resistencia: camera plunges from space to sea level, looks up at nodo
  { id: 'resistencia',
    px:  0.50, py: -1.20, pz:  5.00,
    lx:  0.00, ly:  0.40, lz:  0.00 },

  // Desierto: rises from sea → sand, near-ground, nodo towers above sand floor
  { id: 'desierto',
    px:  1.60, py:  0.25, pz:  4.50,
    lx:  0.00, ly:  0.55, lz:  0.00 },

  // Impacto: side angle, low — shows pared.glb + roca.glb impact
  { id: 'impacto',
    px: -2.20, py:  0.50, pz:  4.20,
    lx:  0.00, ly:  0.00, lz:  0.00 },

  // App: clean centered front shot — smartphone 3D UI
  { id: 'app',
    px:  0.00, py:  0.80, pz:  5.50,
    lx:  0.00, ly:  0.20, lz:  0.00 },
]

// Easing per transition — each has a cinematic character
const EASES = [
  'power2.inOut',  // Hero → Usuarios           — smooth, elegant pan
  'power3.in',     // Usuarios → Cifrado        — accelerating escape velocity
  'power4.out',    // Cifrado → Resistencia     — hard deceleration into the sea
  'power3.out',    // Resistencia → Desierto    — rises from sea floor to desert sand
  'power2.inOut',  // Desierto → Impacto        — steady side-pan
  'power1.inOut',  // Impacto → App             — gentle, clean landing
]

// ─── TimelineManager ───────────────────────────────────────────────────────────
export class TimelineManager {
  /**
   * @param {{
   *   camera:         THREE.PerspectiveCamera,
   *   controls:       OrbitControls,
   *   sectionManager: SectionManager,
   *   trackSelector:  string,   CSS selector for the full-height scroll track
   * }} params
   */
  constructor({ camera, controls, sectionManager, trackSelector }) {
    this._camera         = camera
    this._controls       = controls
    this._sm             = sectionManager
    this._trackSelector  = trackSelector

    // Camera rig proxy — GSAP animates these flat scalars for perf
    this._rig = {
      px: WAYPOINTS[0].px, py: WAYPOINTS[0].py, pz: WAYPOINTS[0].pz,
      lx: WAYPOINTS[0].lx, ly: WAYPOINTS[0].ly, lz: WAYPOINTS[0].lz,
    }

    this._mainTL          = null
    this._sectionTriggers = []
  }

  // ── Build ─────────────────────────────────────────────────────────────────────
  build() {
    this._buildMainTimeline()
    this._buildSectionMarkers()
    ScrollTrigger.refresh()
    console.info('[TimelineManager] ✓ Master timeline built — 6 sections, scrub: 1')
  }

  // ── Master camera timeline ────────────────────────────────────────────────────
  _buildMainTimeline() {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger:  this._trackSelector,
        start:    'top top',
        end:      'bottom bottom',
        scrub:    1,              // 1-second lag = inertia / premium weight
        onUpdate: (self) => {
          // ── Camera handoff: OrbitControls ↔ GSAP ────────────────────────────
          // Hero section (progress < ~2%) keeps autoRotate.
          // First real scroll disables OrbitControls so GSAP owns the camera.
          if (self.progress > 0.015) {
            if (this._controls.enabled) {
              this._controls.autoRotate = false
              this._controls.enabled    = false
            }
          } else {
            if (!this._controls.enabled) {
              this._controls.enabled    = true
              this._controls.autoRotate = true
              this._controls.target.set(WAYPOINTS[0].lx, WAYPOINTS[0].ly, WAYPOINTS[0].lz)
            }
          }

          // ── Apply rig to camera ──────────────────────────────────────────────
          if (!this._controls.enabled) {
            this._applyRig()
          }
        },
      },
    })

    // Tween through each waypoint
    for (let i = 1; i < WAYPOINTS.length; i++) {
      const wp   = WAYPOINTS[i]
      const ease = EASES[i - 1]
      tl.to(this._rig, {
        px: wp.px, py: wp.py, pz: wp.pz,
        lx: wp.lx, ly: wp.ly, lz: wp.lz,
        ease,
        duration: 1,
      })
    }

    this._mainTL = tl
  }

  // ── Per-section onEnter / onLeave markers ─────────────────────────────────────
  _buildSectionMarkers() {
    WAYPOINTS.forEach((wp) => {
      const el = document.querySelector(`[data-section="${wp.id}"]`)
      if (!el) {
        console.warn(`[TimelineManager] DOM element not found: [data-section="${wp.id}"]`)
        return
      }

      const st = ScrollTrigger.create({
        trigger:    el,
        start:      'top 60%',
        end:        'bottom 40%',
        onEnter:      () => { console.debug(`[§] enter: ${wp.id}`); this._sm.trigger(wp.id, 'enter') },
        onLeave:      () => { console.debug(`[§] leave: ${wp.id}`); this._sm.trigger(wp.id, 'leave') },
        onEnterBack:  () => { console.debug(`[§] re-enter: ${wp.id}`); this._sm.trigger(wp.id, 'enter') },
        onLeaveBack:  () => { console.debug(`[§] back-leave: ${wp.id}`); this._sm.trigger(wp.id, 'leave') },
      })
      this._sectionTriggers.push(st)
    })
  }

  // ── Write rig to camera (only when OrbitControls is disabled) ─────────────────
  _applyRig() {
    const r = this._rig
    this._camera.position.set(r.px, r.py, r.pz)
    this._camera.lookAt(r.lx, r.ly, r.lz)
    // Also update controls.target so it stays in sync for when controls re-enable
    this._controls.target.set(r.lx, r.ly, r.lz)
  }

  // ── Public API ────────────────────────────────────────────────────────────────

  /** Direct access to rig for micro-animations (camera shake, etc.) */
  getRig() { return this._rig }

  /** All waypoint definitions */
  getWaypoints() { return WAYPOINTS }

  /** Jump camera to a named waypoint (no scroll — instant, for debug) */
  jumpTo(sectionId) {
    const wp = WAYPOINTS.find(w => w.id === sectionId)
    if (!wp) return
    Object.assign(this._rig, { px: wp.px, py: wp.py, pz: wp.pz,
                                lx: wp.lx, ly: wp.ly, lz: wp.lz })
    this._applyRig()
  }

  // ── Cleanup ────────────────────────────────────────────────────────────────────
  dispose() {
    this._sectionTriggers.forEach(t => t.kill())
    this._sectionTriggers = []
    this._mainTL?.scrollTrigger?.kill()
    this._mainTL?.kill()
  }
}
