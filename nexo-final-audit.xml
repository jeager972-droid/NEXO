// ─── HeatHazeShader ────────────────────────────────────────────────────────────
// Screen-space heat distortion effect. Used as a ShaderPass in EffectComposer.
// Added to the pipeline disabled (intensity 0); DesiertoScene tweens it on enter.
//
// Pipeline position:  RenderPass → SMAA → Bloom → HeatHaze → OutputPass
// Tween target:       composer.heatHaze.uniforms.uIntensity.value  (0 … 1)
// Tick update:        composer.heatHaze.uniforms.uTime.value = t

export const HeatHazeShader = {
  name: 'HeatHazeShader',

  uniforms: {
    tDiffuse:   { value: null },   // provided automatically by ShaderPass
    uTime:      { value: 0 },
    uIntensity: { value: 0 },      // 0 = off, 1 = full desert shimmer
  },

  vertexShader: /* glsl */`
    varying vec2 vUv;
    void main() {
      vUv         = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,

  fragmentShader: /* glsl */`
    uniform sampler2D tDiffuse;
    uniform float     uTime;
    uniform float     uIntensity;
    varying vec2      vUv;

    void main() {
      vec2  uv = vUv;

      // Three layered sine waves on Y — creates rising hot-air shimmer columns
      float d =
        sin(uv.y * 18.0 + uTime * 2.80) * 0.0030 +
        sin(uv.y * 37.0 + uTime * 1.55) * 0.0015 +
        sin(uv.x * 12.0 + uTime * 1.10) * 0.0010;

      uv.x += d * uIntensity;

      gl_FragColor = texture2D(tDiffuse, uv);
    }
  `,
}
