import { useEffect, useRef, useState } from 'react'
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import { SceneSetup }         from './core/SceneSetup'
import { createComposer }      from './core/Composer'
import { AssetManager }        from './core/AssetManager'
import { HeroScene }           from './scenes/HeroScene'
import { SectionManager }      from './core/SectionManager'
import { MaterialController }  from './core/MaterialController'
import { TimelineManager }     from './core/TimelineManager'
import { CifradoScene }       from './scenes/CifradoScene'
import { ResistenciaScene }  from './scenes/ResistenciaScene'
import { DesiertoScene }     from './scenes/DesiertoScene'
import { ImpactoScene }     from './scenes/ImpactoScene'
import { AppScene }         from './scenes/AppScene'
import TextOverlay           from './components/TextOverlay'
import './LandingPage.css'

// ─── WebGL capability check ────────────────────────────────────────────────────
function supportsWebGL() {
  try {
    const canvas = document.createElement('canvas')
    return !!(
      window.WebGLRenderingContext &&
      (canvas.getContext('webgl2') || canvas.getContext('webgl'))
    )
  } catch (_) {
    return false
  }
}

// ─── LandingPage ───────────────────────────────────────────────────────────────
export default function LandingPage() {
  const canvasRef = useRef(null)

  const [noWebGL,   setNoWebGL]   = useState(false)
  const [hideScrollIndicator, setHideScrollIndicator] = useState(false)

  useEffect(() => {
    if (!supportsWebGL()) { setNoWebGL(true); return }

    let setup        = null
    let tlMgr        = null
    let rafId        = null
    const tickables  = []   // { tick: (t: number) => void }[]

    async function init() {
      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 1 — Core Three.js setup (renderer, scene, camera, controls)
      // ═══════════════════════════════════════════════════════════════════════
      setup = new SceneSetup(canvasRef.current)

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 2 — Asset loading (GLB models, EXR/HDR env maps, textures)
      // ═══════════════════════════════════════════════════════════════════════
      const manager = new AssetManager(
        (_url, _loaded, _total) => {},
        () => {},
        (url, err) => console.error('[NEXO] AssetManager error:', url, err),
      )
      const assets = await manager.loadAll(setup.renderer)

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 3 — Hero Scene (nodo.glb — the flagship IoT node)
      // ═══════════════════════════════════════════════════════════════════════
      const matCtrl = new MaterialController()
      new HeroScene({
        scene:              setup.scene,
        camera:             setup.camera,
        controls:           setup.controls,
        assets,
        materialController: matCtrl,
      }).build()

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 4 — Post-processing (EffectComposer + UnrealBloomPass)
      // ═══════════════════════════════════════════════════════════════════════
      const composer = createComposer(setup.renderer, setup.scene, setup.camera)
      setup.composer = composer

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 5 — Scene instantiation (all 3D worlds built invisible)
      // ═══════════════════════════════════════════════════════════════════════

      // 5a — Cifrado (planet + network data planes + starfield)
      const cifrado = new CifradoScene({ scene: setup.scene, assets })
      cifrado.build()
      tickables.push(cifrado)

      // 5b — Resistencia (IP66 nodo + GPU rain + water plane)
      const resistencia = new ResistenciaScene({
        scene:    setup.scene,
        camera:   setup.camera,
        renderer: setup.renderer,
        composer,
        assets,
        matCtrl,
      })
      resistencia.build()
      tickables.push(resistencia)

      // 5c — Desierto (sand floor + 8k storm particles + sun)
      const desierto = new DesiertoScene({
        scene:    setup.scene,
        renderer: setup.renderer,
        composer,
        assets,
        matCtrl,
      })
      await desierto.build()
      tickables.push(desierto)

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 6 — Section Manager (scroll lifecycle hooks)
      // ═══════════════════════════════════════════════════════════════════════
      const secMgr = new SectionManager()

      secMgr
        .on('hero', {
          onEnter: () => {
            setup.controls.enabled    = true
            setup.controls.autoRotate = true
          },
          onLeave: () => {
            setup.controls.autoRotate = false
          },
        })
        .on('usuarios', {
          onEnter: () => {},
          onLeave: () => {},
        })
        .on('cifrado', {
          onEnter: () => cifrado.enter(),
          onLeave: () => cifrado.leave(),
        })
        .on('resistencia', {
          onEnter: () => resistencia.enter(),
          onLeave: () => resistencia.leave(),
        })
        .on('desierto', {
          onEnter: () => desierto.enter(),
          onLeave: () => desierto.leave(),
        })

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 7 — GSAP ScrollTrigger master timeline (camera rig + waypoints)
      // ═══════════════════════════════════════════════════════════════════════
      tlMgr = new TimelineManager({
        camera:         setup.camera,
        controls:       setup.controls,
        sectionManager: secMgr,
        trackSelector:  '#nx-scroll-track',
      })
      tlMgr.build()

      // 5d — Impacto (concrete wall + rock projectile + sparks)
      //       Built AFTER tlMgr because it needs getRig() for camera shake
      const impacto = new ImpactoScene({
        scene:    setup.scene,
        camera:   setup.camera,
        renderer: setup.renderer,
        composer,
        assets,
        tlMgr,
      })
      impacto.build()
      tickables.push(impacto)

      secMgr.on('impacto', {
        onEnter: () => impacto.enter(),
        onLeave: () => impacto.leave(),
      })

      // 5e — App (procedural smartphone + beam + 4-state CanvasTexture UI)
      const app = new AppScene({
        scene:    setup.scene,
        camera:   setup.camera,
        renderer: setup.renderer,
        composer,
        assets,
      })
      app.build()
      tickables.push(app)

      secMgr.on('app', {
        onEnter: () => app.enter(),
        onLeave: () => app.leave(),
      })

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 8 — Scroll indicator fade-out
      // ═══════════════════════════════════════════════════════════════════════
      const handleScroll = () => {
        if (window.scrollY > 50) {
          setHideScrollIndicator(true)
          window.removeEventListener('scroll', handleScroll)
        }
      }
      window.addEventListener('scroll', handleScroll, { passive: true })

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 8½ — Refresh ScrollTrigger after heavy models load
      // ═══════════════════════════════════════════════════════════════════════
      setTimeout(() => { ScrollTrigger.refresh() }, 1000)

      // ═══════════════════════════════════════════════════════════════════════
      //  STAGE 9 — Render loop (60fps + tickables)
      // ═══════════════════════════════════════════════════════════════════════
      const tick = () => {
        rafId = requestAnimationFrame(tick)
        const t = performance.now() / 1000
        setup.tick()
        tickables.forEach(tb => tb.tick(t))
        composer.render()
      }
      tick()
    }

    init().catch((err) => {
      console.error('[NEXO] Landing init failed:', err)
    })

    return () => {
      cancelAnimationFrame(rafId)
      tlMgr?.dispose()
      tickables.forEach(tb => tb.dispose?.())
      setup?.dispose()
    }
  }, [])

  if (noWebGL) {
    return (
      <div className="nx-no-webgl">
        <strong>NEXO</strong>
        <span>Tu navegador no soporta WebGL 2.0</span>
      </div>
    )
  }

  return (
    <div className="nx-root">
      <canvas ref={canvasRef} className="nx-canvas" aria-hidden="true" />

      {/* ── Montfort text overlays ────────────────────────────────────────────── */}
      <TextOverlay />

      {/* ── Scroll indicator ─────────────────────────────────────────────────── */}
      <div className={`nx-scroll-indicator${hideScrollIndicator ? ' nx-scroll-indicator--hidden' : ''}`}>
        <div className="nx-scroll-indicator__line" />
        <div className="nx-scroll-indicator__arrow" />
      </div>

      {/* ── Scroll track — 7 × 100vh = 700vh of scroll real estate ───────────── */}
      <div id="nx-scroll-track" className="nx-scroll-track">
        <section className="nx-section" data-section="hero" />
        <section className="nx-section" data-section="usuarios" />
        <section className="nx-section" data-section="cifrado" />
        <section className="nx-section" data-section="resistencia" />
        <section className="nx-section" data-section="desierto" />
        <section className="nx-section" data-section="impacto" />
        <section className="nx-section" data-section="app" />
      </div>
    </div>
  )
}
</file>

