  // Stat cards
  ;[['143', 'Presentes hoy', 44], ['12', 'Secciones activas', 298]].forEach(([val, lbl, x]) => {
    ctx.fillStyle = 'rgba(255,255,255,0.07)'
    rrect(ctx, x, 252, 192, 98, 12); ctx.fill()
