import * as THREE from 'three'
import { EffectComposer }    from 'three/examples/jsm/postprocessing/EffectComposer.js'
import { RenderPass }        from 'three/examples/jsm/postprocessing/RenderPass.js'
import { SMAAPass }          from 'three/examples/jsm/postprocessing/SMAAPass.js'
import { UnrealBloomPass }   from 'three/examples/jsm/postprocessing/UnrealBloomPass.js'
import { ShaderPass }        from 'three/examples/jsm/postprocessing/ShaderPass.js'
import { OutputPass }        from 'three/examples/jsm/postprocessing/OutputPass.js'
import { HeatHazeShader }    from './HeatHazeShader.js'

/**
 * Build the post-processing pipeline:
 *
 *   RenderPass  →  SMAAPass  →  OutputPass
 *
 * Pipeline:  RenderPass  →  SMAAPass  →  UnrealBloomPass  →  HeatHaze(off)  →  OutputPass
 *
 * Bloom settings are conservative (threshold 0.82) so only true specular
 * highlights and HDR-overbright values bloom.  ResistenciaScene tweens
 * composer.bloom.strength to 1.3 during the storm section.
 *
 * OutputPass (Three.js r155+) handles ACESFilmic tone mapping + SRGBColorSpace
 * in a single shader.
 *
 * @param {THREE.WebGLRenderer} renderer
 * @param {THREE.Scene}         scene
 * @param {THREE.Camera}        camera
 * @returns {EffectComposer & { bloom: UnrealBloomPass }}
 */
export function createComposer(renderer, scene, camera) {
  const pr = renderer.getPixelRatio()
  const w  = window.innerWidth  * pr
  const h  = window.innerHeight * pr

  const composer = new EffectComposer(renderer)

  composer.addPass(new RenderPass(scene, camera))
  composer.addPass(new SMAAPass(w, h))

  // Emergency bloom — very conservative to prevent blinding neon
  const bloom = new UnrealBloomPass(
    new THREE.Vector2(w, h),
    0.20,   // strength  — ultra-conservative
    0.50,   // radius    — medium halos
    0.95,   // threshold — only extreme highlights
  )
  composer.addPass(bloom)
  composer.bloom = bloom    // expose for intensity tweens from scene modules

  // Heat haze distortion — disabled until DesiertoScene enters
  const heatHaze = new ShaderPass(HeatHazeShader)
  heatHaze.enabled = false
  composer.addPass(heatHaze)
  composer.heatHaze = heatHaze  // expose for DesiertoScene

  composer.addPass(new OutputPass())  // tone mapping + SRGBColorSpace

  return composer
}
