import * as THREE from 'three'
import gsap from 'gsap'

// ─── Timings ───────────────────────────────────────────────────────────────────
const LAUNCH_DURATION = 1.40   // seconds rock is in flight
const LOOP_INTERVAL   = 7000   // ms between impact sequences

// ─── Helpers ──────────────────────────────────────────────────────────────────

// Auto-fit a GLB model to a target max dimension (world units)
function fitModel(model, targetSize) {
  const box    = new THREE.Box3().setFromObject(model)
  const maxDim = box.getSize(new THREE.Vector3()).length()
  if (maxDim > 0) model.scale.setScalar(targetSize / maxDim)
}

// ─── ImpactoScene ─────────────────────────────────────────────────────────────
export class ImpactoScene {
  /**
   * @param {{
   *   scene:    THREE.Scene,
   *   camera:   THREE.PerspectiveCamera,
   *   renderer: THREE.WebGLRenderer,
   *   composer: EffectComposer & { bloom },
   *   assets:   Record<string, any>,
   *   tlMgr:    TimelineManager,
   * }} params
   */
  constructor({ scene, camera, renderer, composer, assets, tlMgr }) {
    this._scene    = scene
    this._camera   = camera
    this._renderer = renderer
    this._composer = composer
    this._assets   = assets
    this._tlMgr    = tlMgr

    this._wall       = null   // concrete wall mesh group
    this._rock       = null   // projectile mesh group
    this._spotLight  = null   // key shadow light
    this._sparks     = null   // spark burst Points
    this._sparkVel   = null   // Float32Array velocities (CPU physics)
    this._sparkAge   = null   // Float32Array ages

    this._active     = false
    this._loopTimer  = null
    this._lastT      = 0

    this._savedBg       = null
    this._savedEnv      = null
    this._savedExposure = 1.0
    this._seqRunning    = false   // prevents overlapping sequences
  }

  // ── Build ─────────────────────────────────────────────────────────────────────
  build() {
    this._setupWall()
    this._setupRock()
    this._setupLights()
    this._setupSparks()
    this._setVisible(false)
    console.info('[ImpactoScene] ✓ Built')
  }

  // ── Concrete wall ─────────────────────────────────────────────────────────────
  _setupWall() {
    const gltf = this._assets.pared
    if (!gltf) {
      console.error('[ImpactoScene] pared.glb not loaded')
      return
    }

    const model = gltf.scene.clone()
    fitModel(model, 9)               // scale to 9-unit span — fills background
    model.position.set(0, 0, -1.8)  // behind the nodo

    model.traverse(c => {
      if (!c.isMesh) return
      c.receiveShadow = true
      c.castShadow    = false
    })

    this._scene.add(model)
    this._wall = model
  }

  // ── Projectile rock ───────────────────────────────────────────────────────────
  _setupRock() {
    const gltf = this._assets.roca
    if (!gltf) {
      console.error('[ImpactoScene] roca.glb not loaded')
      return
    }

    const model = gltf.scene.clone()
    fitModel(model, 0.35)            // small rock ≈ 0.35 world units

    model.traverse(c => {
      if (c.isMesh) { c.castShadow = true; c.receiveShadow = false }
    })

    model.visible = false
    this._scene.add(model)
    this._rock = model
  }

  // ── Stage lighting: key SpotLight (casts nodo shadow on concrete) ────────────
  _setupLights() {
    const spot = new THREE.SpotLight(0xfff8f0, 5.0)
    spot.position.set(-4, 7, 5)
    spot.target.position.set(0, 0, 0)
    spot.angle          = Math.PI / 9    // ~20° narrow cone
    spot.penumbra       = 0.35           // soft edge
    spot.castShadow     = true
    spot.shadow.mapSize.set(2048, 2048)
    spot.shadow.camera.near  = 0.5
    spot.shadow.camera.far   = 25
    spot.shadow.bias         = -0.002    // prevents shadow acne
    this._scene.add(spot)
    this._scene.add(spot.target)
    this._spotLight = spot

    // Soft fill from right — removes harsh opposite shadows
    const fill = new THREE.DirectionalLight(0xddeeff, 1.2)
    fill.position.set(5, 2, 3)
    this._scene.add(fill)
    this._fillLight = fill
  }

  // ── CPU spark burst (80 particles, one-shot, gravity) ─────────────────────────
  _setupSparks() {
    const COUNT = 80
    const pos   = new Float32Array(COUNT * 3)

    const geo = new THREE.BufferGeometry()
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))

    const mat = new THREE.PointsMaterial({
      color:           0xff7700,
      size:            0.055,
      sizeAttenuation: true,
      transparent:     true,
      opacity:         0,
      depthWrite:      false,
      blending:        THREE.AdditiveBlending,
    })

    this._sparks    = new THREE.Points(geo, mat)
    this._sparkVel  = new Float32Array(COUNT * 3)
    this._sparkAge  = new Float32Array(COUNT)
    this._sparkMaxAge = 0.75
    this._scene.add(this._sparks)
  }

  // ── Batch visibility ─────────────────────────────────────────────────────────
  _setVisible(v) {
    this._wall?.traverse(c => { if (c.isMesh) c.visible = v })
    if (this._spotLight)  { this._spotLight.visible  = v; this._fillLight.visible = v }
  }

  // ── Environment: restore crystal-clear studio for impact detail ──────────────
  _swapEnv(newEnv, targetIntensity) {
    const can = 'environmentIntensity' in this._scene
    const swap = () => {
      this._scene.environment = newEnv
      if (can) gsap.to(this._scene, { environmentIntensity: targetIntensity, duration: 0.8 })
    }
    if (can) gsap.to(this._scene, { environmentIntensity: 0, duration: 0.4, onComplete: swap })
    else swap()
  }

  // ── Section lifecycle ─────────────────────────────────────────────────────────
  enter() {
    if (this._active) return
    this._active = true

    this._savedBg       = this._scene.background
    this._savedEnv      = this._scene.environment
    this._savedExposure = this._renderer.toneMappingExposure

    // Studio env — crisp lighting reveals wall texture detail
    const studioEnv = this._assets.studioEnv ?? this._savedEnv
    this._swapEnv(studioEnv, 1.1)
    gsap.to(this._renderer, { toneMappingExposure: 0.90, duration: 1.0 })

    this._setVisible(true)

    // Slight bloom reduction — we want sharp concrete, not glow overload
    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 0.35, duration: 0.8 })
    }

    // First sequence fires after a 1.5 s entrance delay
    setTimeout(() => this._runSequence(), 1500)
  }

  leave() {
    if (!this._active) return
    this._active = false

    clearTimeout(this._loopTimer)
    this._seqRunning = false

    this._swapEnv(this._savedEnv, 1.2)
    this._scene.background = this._savedBg
    gsap.to(this._renderer, { toneMappingExposure: this._savedExposure, duration: 0.8 })

    if (this._composer?.bloom) {
      gsap.to(this._composer.bloom, { strength: 0.50, duration: 0.6 })
    }

    if (this._rock) this._rock.visible = false
    this._setVisible(false)
  }

  // ── Full impact sequence ──────────────────────────────────────────────────────
  _runSequence() {
    if (!this._active || this._seqRunning) return
    this._seqRunning = true

    this._launchRock()
  }

  _launchRock() {
    const rock = this._rock
    if (!rock) {
      this._scheduleLoop()
      return
    }

    // Reset rock state
    rock.visible = true
    rock.position.set(-5.5, 1.8, 1.5)
    rock.rotation.set(0, 0, 0)
    gsap.killTweensOf(rock.position)
    gsap.killTweensOf(rock.rotation)

    // ── Parabolic flight ────────────────────────────────────────────────────────
    // X/Z: power2.in (accelerates like gravity-aided trajectory)
    // Y: arc up then fall — approximated via GSAP keyframes
    const tl = gsap.timeline({ onComplete: () => this._triggerImpact() })

    tl.to(rock.position, {
      x: 0, z: 0,
      duration: LAUNCH_DURATION,
      ease: 'power2.in',
    }, 0)

    tl.to(rock.position, {
      keyframes: [
        { y: 3.2, ease: 'power1.out', duration: LAUNCH_DURATION * 0.40 },
        { y: 0,   ease: 'power2.in',  duration: LAUNCH_DURATION * 0.60 },
      ],
    }, 0)

    // Spin during flight
    tl.to(rock.rotation, {
      x: Math.PI * 5,
      y: Math.PI * 3.5,
      z: Math.PI * 2,
      duration: LAUNCH_DURATION,
      ease: 'power1.in',
    }, 0)
  }

  _triggerImpact() {
    // ── 1. Nodo recoil shudder (X / Z micro-vibration) ─────────────────────────
    const nodo = this._assets.nodo?.scene
    if (nodo) {
      const ox = nodo.position.x, oz = nodo.position.z
      gsap.timeline()
        .to(nodo.position, { x: ox + 0.10, z: oz + 0.06, duration: 0.028, ease: 'none' })
        .to(nodo.position, { x: ox - 0.08, z: oz - 0.05, duration: 0.030, ease: 'none' })
        .to(nodo.position, { x: ox + 0.05, z: oz + 0.03, duration: 0.024, ease: 'none' })
        .to(nodo.position, { x: ox - 0.03, z: oz - 0.02, duration: 0.022, ease: 'none' })
        .to(nodo.position, { x: ox,        z: oz,        duration: 0.036, ease: 'power2.out' })
    }

    // ── 2. Camera shake (direct camera.position perturbation) ──────────────────
    const cam = this._camera
    const cx = cam.position.x, cy = cam.position.y, cz = cam.position.z
    gsap.timeline()
      .to(cam.position, { x: cx + 0.14, y: cy + 0.09, duration: 0.028, ease: 'none' })
      .to(cam.position, { x: cx - 0.11, y: cy - 0.07, duration: 0.032, ease: 'none' })
      .to(cam.position, { x: cx + 0.07, y: cy + 0.04, duration: 0.026, ease: 'none' })
      .to(cam.position, { x: cx,        y: cy,        z: cz, duration: 0.044, ease: 'power2.out' })

    // ── 3. Spark burst (CPU particles explode from impact point) ───────────────
    this._emitSparks()

    // ── 4. Bloom flash (brief intensity spike) ─────────────────────────────────
    if (this._composer?.bloom) {
      gsap.timeline()
        .to(this._composer.bloom, { strength: 1.80, duration: 0.04 })
        .to(this._composer.bloom, { strength: 0.35, duration: 0.25, ease: 'power3.out' })
    }

    // ── 5. Rock bounce + fall out of frame ─────────────────────────────────────
    this._bounceRock()
  }

  _bounceRock() {
    const rock = this._rock
    if (!rock) return

    const tl = gsap.timeline({ onComplete: () => {
      rock.visible = false
      this._seqRunning = false
      this._scheduleLoop()
    }})

    // Bounce back toward camera-right with erratic spin
    tl.to(rock.position, {
      x: 3.5, y: -4.5, z: 3.5,
      duration: 1.5,
      ease: 'power2.in',    // gravity accelerates the fall
    }, 0)
    tl.to(rock.rotation, {
      x: Math.PI * 12,
      y: Math.PI * 8,
      z: Math.PI * -5,
      duration: 1.5,
      ease: 'power1.out',   // spin slows as rock falls away
    }, 0)
  }

  _scheduleLoop() {
    if (!this._active) return
    this._loopTimer = setTimeout(() => this._runSequence(), LOOP_INTERVAL)
  }

  // ── CPU spark physics ─────────────────────────────────────────────────────────
  _emitSparks() {
    const COUNT = 80
    const pos   = this._sparks.geometry.attributes.position.array

    for (let i = 0; i < COUNT; i++) {
      // Emit from nodo front face
      pos[i * 3] = pos[i * 3 + 1] = pos[i * 3 + 2] = 0

      const theta = Math.random() * Math.PI * 2
      const phi   = Math.random() * Math.PI
      const spd   = 2.0 + Math.random() * 5.5

      // Mostly forward (toward camera) + upward bias
      this._sparkVel[i * 3]     = Math.sin(phi) * Math.cos(theta) * spd
      this._sparkVel[i * 3 + 1] = (Math.abs(Math.cos(phi)) * 0.6 + 0.4) * spd
      this._sparkVel[i * 3 + 2] = Math.abs(Math.sin(phi) * Math.sin(theta)) * spd + 0.5

      this._sparkAge[i] = 0
    }

    this._sparks.geometry.attributes.position.needsUpdate = true
    this._sparks.visible = true
    this._sparks.material.opacity = 1.0

    // Fade the point cloud over maxAge seconds
    gsap.to(this._sparks.material, {
      opacity: 0,
      duration: this._sparkMaxAge,
      ease: 'power2.in',
      onComplete: () => { this._sparks.visible = false },
    })
  }

  _tickSparks(dt) {
    if (!this._sparks.visible) return

    const pos = this._sparks.geometry.attributes.position.array
    const COUNT = 80

    for (let i = 0; i < COUNT; i++) {
      if (this._sparkAge[i] >= this._sparkMaxAge) continue
      this._sparkAge[i] += dt

      // Gravity
      this._sparkVel[i * 3 + 1] -= 9.8 * dt

      // Integrate
      pos[i * 3]     += this._sparkVel[i * 3]     * dt
      pos[i * 3 + 1] += this._sparkVel[i * 3 + 1] * dt
      pos[i * 3 + 2] += this._sparkVel[i * 3 + 2] * dt
    }

    this._sparks.geometry.attributes.position.needsUpdate = true
  }

  // ── Tick ─────────────────────────────────────────────────────────────────────
  tick(t) {
    const dt = this._lastT > 0 ? Math.min(t - this._lastT, 0.05) : 0.016
    this._lastT = t

    if (!this._active) return
    this._tickSparks(dt)
  }

  // ── Cleanup ───────────────────────────────────────────────────────────────────
  dispose() {
    clearTimeout(this._loopTimer)
    this._wall?.traverse(c => { c.geometry?.dispose(); c.material?.dispose() })
    this._rock?.traverse(c => { c.geometry?.dispose(); c.material?.dispose() })
    this._sparks?.geometry.dispose()
    this._sparks?.material.dispose()
  }
}
