  ctx.fillStyle = '#fff'; ctx.font = 'bold 22px system-ui'; ctx.textAlign = 'left'
  ctx.fillText('NEXO Colegio', 84, 32)
  ctx.fillStyle = 'rgba(255,255,255,0.7)'; ctx.font = '15px system-ui'
  ctx.fillText('en línea', 84, 56)
  ctx.fillStyle = '#fff'; ctx.font = '24px system-ui'; ctx.textAlign = 'right'
  ctx.fillText('⋮', CW - 20, 44)

  // Date separator
  ctx.fillStyle = 'rgba(0,0,0,0.25)'
  rrect(ctx, CW / 2 - 55, 96, 110, 24, 12); ctx.fill()
  ctx.fillStyle = '#fff'; ctx.font = '13px system-ui'; ctx.textAlign = 'center'
  ctx.fillText('Hoy', CW / 2, 109)

  // Received bubble
  ctx.fillStyle = '#fff'
  rrect(ctx, 24, 132, CW - 60, 420, 12); ctx.fill()
  ctx.fillStyle = '#111'; ctx.font = '18px system-ui'; ctx.textAlign = 'left'
  const lines = [
    'Estimada acudiente,',
    '',
    'Usted está citada para el',
    'martes 20 de mayo a las 2:00 PM',
    '',
    'Motivo: Reunión de orientación.',
    '',
    'Por favor confirme su asistencia',
    'respondiendo: CONFIRMO',
    '',
    'Atentamente,',
    'Coordinación NEXO 🏫',
  ]
  lines.forEach((l, i) => ctx.fillText(l, 42, 168 + i * 30))

  // Timestamp
  ctx.fillStyle = '#7a9ab0'; ctx.font = '14px system-ui'; ctx.textAlign = 'right'
  ctx.fillText('9:41 PM  ✓✓', CW - 42, 572)

  // Restart button
  ctx.fillStyle = '#128C7E'
  rrect(ctx, 40, 850, CW - 80, 60, 30); ctx.fill()
  ctx.fillStyle = '#fff'; ctx.font = 'bold 20px system-ui'; ctx.textAlign = 'center'
