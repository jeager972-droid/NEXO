import { useEffect, useRef } from 'react'
import gsap from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

gsap.registerPlugin(ScrollTrigger)

// ─── Copywriting overlays per section (Montfort/Emil Kowalski style) ─────────────
const OVERLAYS = [
  {
    id: 'hero',
    title: 'NEXO',
    subtitle: 'Soberanía Educativa Digital',
    position: 'center'
  },
  {
    id: 'usuarios',
    title: 'Para Quién',
    lines: [
      'Estudiantes: Aprendizaje sin fronteras.',
      'Acudientes: Conexión en tiempo real.',
      'Profesores: Gestión simplificada.',
      'Directivos: Visión completa del campus.'
    ],
    position: 'left'
  },
  {
    id: 'cifrado',
    title: 'Cifrado',
    subtitle: 'Infraestructura Híbrida con Audit Chain (HMAC-SHA256)',
    position: 'left'
  },
  {
    id: 'resistencia',
    title: 'Resistencia',
    subtitle: 'Certificación IP66. Blindaje Monolítico.',
    position: 'left'
  },
  {
    id: 'desierto',
    title: 'Desierto',
    subtitle: 'Operaciones extremas. IoT en cualquier condición.',
    position: 'left'
  },
  {
    id: 'impacto',
    title: 'Seguridad',
    subtitle: 'Pared de concreto + impacto de roca. Probado en combate.',
    position: 'left'
  },
  {
    id: 'app',
    title: 'App',
    subtitle: 'Corresponsabilidad familiar en tiempo real.',
    position: 'left'
  }
]

export default function TextOverlay() {
  const overlaysRef = useRef([])

  useEffect(() => {
    const ctx = gsap.context(() => {
      OVERLAYS.forEach((overlay, i) => {
        const sectionEl = document.querySelector(`[data-section="${overlay.id}"]`)
        const overlayEl = overlaysRef.current[i]

        if (!sectionEl || !overlayEl) return

        gsap.fromTo(overlayEl,
          { autoAlpha: 0, y: 50, scale: 0.95 },
          {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 1.0,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: sectionEl,
              start: 'top 70%',
              end: 'bottom 30%',
              toggleActions: 'play reverse play reverse',
            }
          }
        )
      })
    })
    return () => ctx.revert()
  }, [])

  return (
    <div className="nx-text-overlay-container">
      {OVERLAYS.map((ov, i) => (
        <div key={ov.id} ref={el => overlaysRef.current[i] = el} className={`nx-text-overlay nx-text-overlay--${ov.position}`}>
          {ov.title && <h1 className="nx-text-overlay__title">{ov.title}</h1>}
          {ov.subtitle && <p className="nx-text-overlay__subtitle">{ov.subtitle}</p>}
          {ov.lines && (
            <div className="nx-text-overlay__lines">
              {ov.lines.map((line, j) => <p key={j} className="nx-text-overlay__line">{line}</p>)}
            </div>
          )}
          {ov.platforms && (
            <div className="nx-text-overlay__platforms">
              {ov.platforms.map(p => <button key={p} className="nx-text-overlay__platform pointer-events-auto">{p}</button>)}
            </div>
          )}
        </div>
      ))}
    </div>
  )
}
