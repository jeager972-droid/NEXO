// ─── SectionManager ────────────────────────────────────────────────────────────
// Lightweight pub/sub for section lifecycle events.
// Stages 4-9 register their effects here via SectionManager.on(id, hooks).
//
// Usage:
//   sm.on('resistencia', { onEnter: () => rain.start(), onLeave: () => rain.stop() })
//   sm.trigger('resistencia', 'enter')   ← called by TimelineManager

export class SectionManager {
  constructor() {
    this._hooks = new Map()   // Map<sectionId, { onEnter?, onLeave? }>
  }

  /**
   * Register enter/leave callbacks for a section.
   * Calling on() twice for the same id MERGES hooks (later overrides earlier).
   *
   * @param {string}   sectionId
   * @param {{ onEnter?: () => void, onLeave?: () => void }} hooks
   * @returns {SectionManager}   chainable
   */
  on(sectionId, hooks) {
    const existing = this._hooks.get(sectionId) ?? {}
    this._hooks.set(sectionId, { ...existing, ...hooks })
    return this
  }

  /**
   * Fire an event for a section. Called by TimelineManager's ScrollTrigger callbacks.
   * @param {string} sectionId
   * @param {'enter'|'leave'} event
   */
  trigger(sectionId, event) {
    const hooks = this._hooks.get(sectionId)
    if (!hooks) {
      console.debug(`[SectionManager] No hooks for "${sectionId}" → "${event}"`)
      return
    }
    if (event === 'enter') hooks.onEnter?.()
    if (event === 'leave') hooks.onLeave?.()
  }

  /** List registered section ids (for debugging). */
  list() { return [...this._hooks.keys()] }
}
