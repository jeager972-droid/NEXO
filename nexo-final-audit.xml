import * as THREE from 'three'
import gsap from 'gsap'

// ─── Helpers ──────────────────────────────────────────────────────────────────
function fitModel(model, targetSize) {
  const box    = new THREE.Box3().setFromObject(model)
  const maxDim = box.getSize(new THREE.Vector3()).length()
  if (maxDim > 0) model.scale.setScalar(targetSize / maxDim)
}

// ─── Fresnel atmosphere GLSL ────────────────────────────────────────────────────
const ATMOS_VS = /* glsl */`
  varying vec3 vNormal;
  varying vec3 vViewDir;
  void main() {
    vNormal    = normalize(normalMatrix * normal);
    vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
    vViewDir   = normalize(-mvPos.xyz);
    gl_Position = projectionMatrix * mvPos;
  }
`
const ATMOS_FS = /* glsl */`
  uniform vec3  uColor;
  uniform float uIntensity;
  varying vec3  vNormal;
  varying vec3  vViewDir;
  void main() {
    float fresnel = pow(1.0 - clamp(dot(vNormal, vViewDir), 0.0, 1.0), 3.0);
    gl_FragColor  = vec4(uColor * uIntensity, fresnel * 0.90);
  }
`

// ─── Procedural network texture (node graph) ────────────────────────────────────
function buildNetworkTexture(seed = 42) {
  const S   = 256
  const cv  = document.createElement('canvas')
  cv.width  = S
  cv.height = S
  const ctx = cv.getContext('2d')

  // Seed-deterministic pseudo-random
  let r = seed
  const rand = () => { r = (r * 1664525 + 1013904223) & 0xffffffff; return (r >>> 0) / 0xffffffff }

  const nodes = Array.from({ length: 14 }, () => ({ x: rand() * S, y: rand() * S }))

  // Lines
  ctx.strokeStyle = 'rgba(70, 200, 255, 0.50)'
  ctx.lineWidth   = 0.85
  nodes.forEach((a, i) => {
    nodes.slice(i + 1).forEach(b => {
      if (Math.hypot(a.x - b.x, a.y - b.y) < S * 0.44) {
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke()
      }
    })
  })

  // Glow halos
  nodes.forEach(n => {
    const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, 8)
    g.addColorStop(0, 'rgba(100, 220, 255, 0.45)')
    g.addColorStop(1, 'rgba(0, 0, 0, 0)')
    ctx.fillStyle = g
    ctx.fillRect(n.x - 8, n.y - 8, 16, 16)
  })

  // Dot cores
  ctx.fillStyle = 'rgba(180, 240, 255, 0.95)'
  nodes.forEach(n => {
    ctx.beginPath(); ctx.arc(n.x, n.y, 2.0, 0, Math.PI * 2); ctx.fill()
  })

  const tex = new THREE.CanvasTexture(cv)
  tex.colorSpace = THREE.SRGBColorSpace
  return tex
}

// ─── Procedural star field (Points geometry) ────────────────────────────────────
function buildStarField(count = 6000) {
  const pos  = new Float32Array(count * 3)
  const cols = new Float32Array(count * 3)

  for (let i = 0; i < count; i++) {
    const phi   = Math.acos(2 * Math.random() - 1)
    const theta = Math.random() * Math.PI * 2
    const r     = 350 + Math.random() * 100
    pos[i * 3]     = r * Math.sin(phi) * Math.cos(theta)
    pos[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta)
    pos[i * 3 + 2] = r * Math.cos(phi)
    // Slight blue–white variance
    const t = Math.random()
    cols[i * 3]     = 0.80 + t * 0.20
    cols[i * 3 + 1] = 0.85 + t * 0.15
    cols[i * 3 + 2] = 1.00
  }

  const geo = new THREE.BufferGeometry()
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))
  geo.setAttribute('color',    new THREE.BufferAttribute(cols, 3))

  const mat = new THREE.PointsMaterial({
    size:            0.65,
    sizeAttenuation: true,
    vertexColors:    true,
    transparent:     true,
    opacity:         0,
    depthWrite:      false,
  })
  return new THREE.Points(geo, mat)
}

// ─── CifradoScene ───────────────────────────────────────────────────────────────
export class CifradoScene {
  /**
   * @param {{
   *   scene:  THREE.Scene,
   *   assets: Record<string, any>,
   * }} params
   */
  constructor({ scene, assets }) {
    this._scene   = scene
    this._assets  = assets

    this._planet     = null   // THREE.Group from planeta.glb
    this._atmos      = null   // Fresnel atmosphere Mesh
    this._stars      = null   // Points star field
    this._planes     = []     // floating data plane Meshes
    this._sunLight   = null   // DirectionalLight (sun)
    this._ambLight   = null   // AmbientLight (deep-space dim)

    this._active     = false
    this._savedBg    = null   // saved scene.background before swap
    this._savedEnv   = null   // saved scene.environment before swap
  }

  // ── Build — called once, objects stay invisible until enter() ────────────────
  build() {
    this._setupPlanet()
    this._setupStars()
    this._setupDataPlanes()
    this._setupLights()
    this._setVisible(false)
    console.info('[CifradoScene] ✓ Built')
  }

  // ── Planet model ───────────────────────────────────────────────────────────────
  _setupPlanet() {
    const gltf = this._assets.planeta
    if (!gltf) {
      console.error('[CifradoScene] planeta.glb not loaded')
      return
    }

    const model = gltf.scene.clone()
    fitModel(model, 2.5)
    model.scale.setScalar(7)
    model.position.set(-9, -5, -65)
    this._scene.add(model)
    this._planet = model

    // Bounding sphere for atmosphere sizing
    const box    = new THREE.Box3().setFromObject(model)
    const sphere = new THREE.Sphere()
    box.getBoundingSphere(sphere)

    // Fresnel atmosphere shell: 8% larger, additive blend → glows at limb
    const atmosGeo = new THREE.SphereGeometry(1, 64, 64)
    const atmosMat = new THREE.ShaderMaterial({
      vertexShader:   ATMOS_VS,
      fragmentShader: ATMOS_FS,
      uniforms: {
        uColor:     { value: new THREE.Color(0x2277ff) },
        uIntensity: { value: 1.0 },
      },
      side:        THREE.FrontSide,
      transparent: true,
      blending:    THREE.AdditiveBlending,
      depthWrite:  false,
    })
    this._atmos = new THREE.Mesh(atmosGeo, atmosMat)
    this._atmos.scale.setScalar(sphere.radius * 1.10)
    this._atmos.position.copy(sphere.center)
    this._scene.add(this._atmos)
  }

  // ── Star field ───────────────────────────────────────────────────────────────
  _setupStars() {
    this._stars = buildStarField(6000)
    this._scene.add(this._stars)
  }

  // ── Floating data planes ─────────────────────────────────────────────────────
  _setupDataPlanes() {
    // 3 planes, different seeds → different node topologies
    const textures = [buildNetworkTexture(7), buildNetworkTexture(42), buildNetworkTexture(99)]

    const configs = [
      { r: 2.6, y:  1.1, phase: 0.0,        speed:  0.22,  rx:  0.30, rz:  0.10 },
      { r: 2.2, y: -0.8, phase: Math.PI * 0.67, speed: -0.16, rx: -0.15, rz:  0.20 },
      { r: 3.0, y:  0.2, phase: Math.PI * 1.3,  speed:  0.18,  rx:  0.10, rz: -0.25 },
    ]

    configs.forEach((cfg, i) => {
      const geo = new THREE.PlaneGeometry(1.6, 1.6)
      const mat = new THREE.MeshBasicMaterial({
        map:         textures[i],
        transparent: true,
        opacity:     0,
        side:        THREE.DoubleSide,
        depthWrite:  false,
        blending:    THREE.AdditiveBlending,
      })
      const mesh = new THREE.Mesh(geo, mat)
      mesh.rotation.x = cfg.rx
      mesh.rotation.z = cfg.rz
      mesh.userData   = { ...cfg }
      this._planes.push(mesh)
      this._scene.add(mesh)
    })
  }

  // ── Space lighting: dramatic sun + deep-space ambient ────────────────────────
  _setupLights() {
    this._sunLight = new THREE.DirectionalLight(0xfff4e0, 5.0)
    this._sunLight.position.set(80, 55, 40)
    this._scene.add(this._sunLight)

    this._ambLight = new THREE.AmbientLight(0x0a1a33, 0.12)
    this._scene.add(this._ambLight)
  }

  // ── Env swap: crossfade studio EXR → space HDR (or back) ─────────────────────
  _swapEnv(newEnv, newBg, targetIntensity) {
    const canTween = 'environmentIntensity' in this._scene

    const doSwap = () => {
      this._scene.environment = newEnv
      this._scene.background  = newBg
      if (canTween) {
        gsap.to(this._scene, { environmentIntensity: targetIntensity, duration: 0.9,
          ease: 'power2.out' })
      }
    }

    if (canTween) {
      gsap.to(this._scene, { environmentIntensity: 0, duration: 0.55,
        ease: 'power2.in', onComplete: doSwap })
    } else {
      doSwap()
    }
  }

  // ── Section lifecycle ────────────────────────────────────────────────────────
  enter() {
    if (this._active) return
    this._active = true

    // Save current scene state for leave()
    this._savedBg  = this._scene.background
    this._savedEnv = this._scene.environment

    // Space env: use estrellasEnv for IBL, null bg (stars rendered as Points)
    const spaceEnv = this._assets.estrellasEnv ?? this._savedEnv
    this._swapEnv(spaceEnv, null, 0.80)

    this._setVisible(true)

    // Fade in stars
    gsap.to(this._stars.material, { opacity: 0.90, duration: 1.8, ease: 'power2.out' })

    // Stagger-fade in data planes
    this._planes.forEach((p, i) => {
      gsap.to(p.material, { opacity: 0.28, duration: 1.2, delay: i * 0.2, ease: 'power2.out' })
    })
  }

  leave() {
    if (!this._active) return
    this._active = false

    // Restore studio environment
    this._swapEnv(this._savedEnv, this._savedBg, 1.2)

    // Fade out
    const fadeOut = (mat, delay = 0) => {
      gsap.to(mat, { opacity: 0, duration: 0.7, delay, ease: 'power2.in' })
    }
    gsap.to(this._stars.material, { opacity: 0, duration: 0.8, ease: 'power2.in',
      onComplete: () => { this._setVisible(false) } })
    this._planes.forEach((p, i) => fadeOut(p.material, i * 0.1))
  }

  // ── Tick — orbit data planes, rotate planet ──────────────────────────────────
  tick(t) {
    if (!this._active) return

    if (this._planet) this._planet.rotation.y = t * 0.035

    this._planes.forEach(mesh => {
      const { r, y, phase, speed, rx } = mesh.userData
      const angle  = t * speed + phase
      mesh.position.x = Math.cos(angle) * r
      mesh.position.z = Math.sin(angle) * r
      mesh.position.y = y + Math.sin(t * 0.4 + phase) * 0.12
      mesh.rotation.y = -angle * 0.6       // face-toward-nodo spin
      mesh.rotation.x = rx + Math.sin(t * 0.25 + phase) * 0.05
    })
  }

  // ── Visibility batch toggle ──────────────────────────────────────────────────
  _setVisible(v) {
    this._planet?.traverse(c => { if (c.isMesh) c.visible = v })
    if (this._atmos)   this._atmos.visible   = v
    if (this._stars)   this._stars.visible   = v
    this._planes.forEach(p => { p.visible = v })
    if (this._sunLight) this._sunLight.visible = v
    if (this._ambLight) this._ambLight.visible = v
  }

  dispose() {
    this._planes.forEach(p => { p.geometry.dispose(); p.material.map?.dispose(); p.material.dispose() })
    this._atmos?.geometry.dispose()
    this._atmos?.material.dispose()
    this._stars?.geometry.dispose()
    this._stars?.material.dispose()
  }
}
