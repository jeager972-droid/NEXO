}

// ─── State 2 — Transmission ────────────────────────────────────────────────────
function drawTransmission(ctx, progress) {
  ctx.fillStyle = '#050810'; ctx.fillRect(0, 0, CW, CH)
  statusBar(ctx)

  // Header
  const dots = progress < 0.33 ? '.' : progress < 0.66 ? '..' : '...'
  ctx.fillStyle = '#e8eeff'; ctx.font = 'bold 28px system-ui'; ctx.textAlign = 'center'
  ctx.fillText('Transmitiendo' + dots, CW / 2, 130)

  // Lock icon
  ctx.font = '80px system-ui'
  ctx.fillText('🔒', CW / 2, 250)
  ctx.fillStyle = G; ctx.font = 'bold 18px system-ui'
  ctx.fillText('AES-256  ·  IP66', CW / 2, 295)

  // Progress bar track
  ctx.fillStyle = 'rgba(255,255,255,0.08)'
  rrect(ctx, 60, 336, CW - 120, 14, 7); ctx.fill()
  // Progress bar fill
  const pw = Math.max(0, Math.min(1, progress)) * (CW - 120)
  const grad = ctx.createLinearGradient(60, 336, 60 + pw, 336)
  grad.addColorStop(0, '#00c875'); grad.addColorStop(1, '#00ff99')
  ctx.fillStyle = grad
  rrect(ctx, 60, 336, pw, 14, 7); ctx.fill()

  const items = [
    [0.10, '✓', 'Cifrado AES-256 verificado'],
    [0.35, '✓', 'Mensaje empaquetado'],
    [0.60, '→', 'Enviando al nodo IoT…'],
    [0.88, '✓', 'Confirmado en la nube'],
  ]
  items.forEach(([thresh, icon, text], i) => {
    const visible = progress >= thresh
    ctx.fillStyle = visible ? (icon === '→' ? G : '#e8eeff') : '#2a3450'
    ctx.font      = '19px system-ui'; ctx.textAlign = 'left'
    ctx.fillText(`${icon}  ${text}`, 60, 400 + i * 52)
  })

  // Hint
  ctx.fillStyle = '#2a3450'; ctx.font = '15px system-ui'; ctx.textAlign = 'center'
  ctx.fillText('El haz de datos viaja hacia el nodo…', CW / 2, 920)
}

// ─── State 3 — WhatsApp ────────────────────────────────────────────────────────
function drawWhatsApp(ctx) {
  // WhatsApp chat bg
  ctx.fillStyle = '#dfe5e7'
  ctx.fillRect(0, 0, CW, CH)

  // Header
  const hGrad = ctx.createLinearGradient(0, 0, 0, 80)
