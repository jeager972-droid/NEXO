import gsap from 'gsap'

// ─── Dry-state PBR defaults (matching HeroScene presets) ──────────────────────
const DRY = { plastic: { roughness: 0.70 }, metal: { roughness: 0.15 } }
// Stage 5 wet state
const WET = { plastic: { roughness: 0.05 }, metal: { roughness: 0.04 } }
// Stage 6 sandy / hot state (desert)
const HOT = { plastic: { roughness: 0.88 }, metal: { roughness: 0.45 } }

// ─── MaterialController ────────────────────────────────────────────────────────
// Stores classified material references from HeroScene so subsequent stages
// can tween PBR properties without knowing the model internals.
//
// Usage:
//   mc.setWet()       // smooth transition to rain roughness
//   mc.setDry()       // restore to factory state
//   mc.tweenRoughness('plastic', 0.9, 1.0)   // arbitrary tween
export class MaterialController {
  constructor() {
    this._plastic = []   // MeshStandardMaterial[] — chassis / housing
    this._metal   = []   // MeshStandardMaterial[] — sensors / connectors
    this._active  = []   // all running gsap tweens (for cleanup)
  }

  // ── Registration (called by HeroScene during model setup) ────────────────────
  registerPlastic(mat) { this._plastic.push(mat) }
  registerMetal(mat)   { this._metal.push(mat) }

  // ── Accessors ─────────────────────────────────────────────────────────────────
  get plasticMaterials() { return this._plastic }
  get metalMaterials()   { return this._metal }
  get allMaterials()     { return [...this._plastic, ...this._metal] }

  // ── Generic roughness tween ───────────────────────────────────────────────────
  /**
   * @param {'plastic'|'metal'|'all'} target
   * @param {number} roughness  target roughness value (0–1)
   * @param {number} duration   seconds
   * @param {string} ease
   */
  tweenRoughness(target, roughness, duration = 1.2, ease = 'power2.inOut') {
    const mats = target === 'plastic' ? this._plastic
               : target === 'metal'   ? this._metal
               : this.allMaterials

    mats.forEach(mat => {
      const tw = gsap.to(mat, {
        roughness,
        duration,
        ease,
        onUpdate:  () => { mat.needsUpdate = true },
        onComplete: () => { this._active = this._active.filter(t => t !== tw) },
      })
      this._active.push(tw)
    })
  }

  // ── Semantic state transitions ────────────────────────────────────────────────

  /** Stage 5 — Node submerged / heavy rain */
  setWet(duration = 1.6) {
    this.tweenRoughness('plastic', WET.plastic.roughness, duration, 'power3.out')
    this.tweenRoughness('metal',   WET.metal.roughness,   duration, 'power3.out')
    // Wet plastic gains subtle metallic sheen (water film on surface)
    this._plastic.forEach(mat => {
      gsap.to(mat, { metalness: 0.12, duration, ease: 'power3.out',
        onUpdate: () => { mat.needsUpdate = true } })
    })
  }

  /** Restore factory PBR state */
  setDry(duration = 1.0) {
    this.tweenRoughness('plastic', DRY.plastic.roughness, duration, 'power2.inOut')
    this.tweenRoughness('metal',   DRY.metal.roughness,   duration, 'power2.inOut')
    // Restore dry plastic metalness to 0
    this._plastic.forEach(mat => {
      gsap.to(mat, { metalness: 0.0, duration, ease: 'power2.inOut',
        onUpdate: () => { mat.needsUpdate = true } })
    })
  }

  /** Stage 6 — Desert heat / sand abrasion */
  setHot(duration = 1.2) {
    this.tweenRoughness('plastic', HOT.plastic.roughness, duration, 'power2.in')
    this.tweenRoughness('metal',   HOT.metal.roughness,   duration, 'power2.in')
  }

  /** Tween metalness on metal parts (Stage 2+ override for dramatic effects) */
  tweenMetalness(value, duration = 1.0, ease = 'power2.inOut') {
    this._metal.forEach(mat => {
      gsap.to(mat, {
        metalness: value,
        duration,
        ease,
        onUpdate: () => { mat.needsUpdate = true },
      })
    })
  }

  /** Kill all running tweens */
  killAll() {
    this._active.forEach(t => t.kill())
    this._active = []
  }
}
