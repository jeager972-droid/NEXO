// ─── State 1 — Form ────────────────────────────────────────────────────────────
function drawForm(ctx) {
  ctx.fillStyle = D; ctx.fillRect(0, 0, CW, CH)
  statusBar(ctx)

  // Header
  ctx.fillStyle = '#0d1220'; ctx.fillRect(0, 50, CW, 78)
  ctx.fillStyle = G; ctx.font = 'bold 22px system-ui'; ctx.textAlign = 'left'
