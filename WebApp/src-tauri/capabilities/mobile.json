{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability para NEXO en Android e iOS",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "biometric:default",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "http:default",
    "http:allow-fetch"
  ]
}
