{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability para NEXO en escritorio (Windows, Linux, macOS)",
  "platforms": ["linux", "windows", "macOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "biometric:default",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "http:default",
    "http:allow-fetch",
    "deep-link:default"
  ]
}
