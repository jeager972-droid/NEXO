# ============================================================
# .repomixignore — Proyecto NEXO
# Objetivo: Incluir solo código fuente y archivos necesarios
# para auditar el funcionamiento del sistema.
# ============================================================

# === Git, IDE, CI metadata ===
.git/
.git-backup-old/
.vscode/
.vercel/
.agents/

# === Dependencias ===
**/node_modules/**
**/vendor/**
**/.pio/
**/.pioenvs/
**/.piolibdeps/

# === Build artifacts (todos los compilados) ===
**/dist/**
**/build/**
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
compile_commands.json

# === Bundles JS/CSS compilados por Vite ===
backend/alojamiento/assets/**

# === Assets binarios pesados ===
**/*.glb
**/*.gltf
**/*.hdr
**/*.exr
backend/alojamiento/assets/environments/
backend/alojamiento/assets/texturas-arena/
backend/alojamiento/assets/textures/
backend/alojamiento/assets/logo/
backend/alojamiento/assets/models/
backend/alojamiento/assets/downloads/
backend/alojamiento/assets-3d/
WebApp/public/assets/
WebApp/public/downloads/
backend/alojamiento/public/assets/
backend/alojamiento/frontend/public/assets/
backend/alojamiento/frontend/public/assets-3d/

# === Archivos de compresión estática (.br / .gz) ===
# Son generados automáticamente; el source ya está presente sin compresión
**/*.br
**/*.gz

# === Binarios compilados / librerías nativas ===
*.o
*.a
*.so*
*.dylib
*.dll
*.map
*.bin
*.elf
backend/lib/

# === PHP: binarios y locks de Composer ===
backend/alojamiento/composer.phar
backend/alojamiento/composer-setup.php
backend/alojamiento/composer.lock

# === JavaScript: package-lock (no es código fuente; es lockfile) ===
WebApp/package-lock.json
backend/alojamiento/frontend/package-lock.json

# === Secretos y entornos ===
*.pem
*.key
*.crt
*.secret
.env
.env.*
.env*.local

# === Logs y archivos temporales ===
logs/
*.log
backend/alojamiento/frontend/dev_server_log.txt
backend/alojamiento/frontend/build.log
__pycache__/
*.pyc
*.pyo

# === Archivos comprimidos / artefactos de release ===
*.zip
landing-downloads.zip
backend/alojamiento/frontend/nexo-frontend.zip

# === Scratch, debug y dev-only ===
backend/alojamiento/frontend/scratch/
backend/alojamiento/frontend/dist/
backend/alojamiento/_dev/
backend/alojamiento/debug_db.php
backend/alojamiento/frontend/node_modules/

# === Archivos sueltos sin valor ===
